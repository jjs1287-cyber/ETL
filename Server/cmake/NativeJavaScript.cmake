enable_language(C)
execute_process(COMMAND C:/Users/Administrator/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe C:/ETL/Tools/Generate-JavaScriptPolicy.py COMMAND_ERROR_IS_FATAL ANY)
option(ETLFORGE_ENABLE_JAVASCRIPT "Enable bounded native JavaScript script blocks" ON)
set(ETLFORGE_QUICKJS "C:/ETL/Dependencies/quickjs-ng-0.17.0")
add_library(etlforge_quickjs STATIC
 "${ETLFORGE_QUICKJS}/quickjs.c" "${ETLFORGE_QUICKJS}/dtoa.c"
 "${ETLFORGE_QUICKJS}/libregexp.c" "${ETLFORGE_QUICKJS}/libunicode.c")
set_property(TARGET etlforge_quickjs PROPERTY C_STANDARD 11)
target_include_directories(etlforge_quickjs PUBLIC "${ETLFORGE_QUICKJS}")
target_compile_definitions(etlforge_quickjs PRIVATE QUICKJS_NG_BUILD WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0602 _CRT_SECURE_NO_WARNINGS)
target_compile_options(etlforge_quickjs PRIVATE /experimental:c11atomics /wd4244 /wd4267 /wd4996)
add_library(etlforge_native_javascript STATIC src/native/javascript/NativeJavaScript.cpp src/native/javascript/ScriptBlocks.cpp)
target_include_directories(etlforge_native_javascript PUBLIC src/native/javascript)
target_link_libraries(etlforge_native_javascript PUBLIC etlforge_quickjs)
target_link_libraries(etlforge_transformation_engine_probe PUBLIC etlforge_native_javascript)
target_compile_definitions(etlforge_transformation_engine_probe PRIVATE ETLFORGE_NATIVE_JAVASCRIPT_ENABLED=$<BOOL:${ETLFORGE_ENABLE_JAVASCRIPT}>)
add_library(etlforge_studio_javascript SHARED src/native/javascript/StudioJavaScriptJNI.cpp)
target_include_directories(etlforge_studio_javascript PRIVATE C:/ETL/Tools/jdk8u504-b01/include C:/ETL/Tools/jdk8u504-b01/include/win32)
target_link_libraries(etlforge_studio_javascript PRIVATE etlforge_native_javascript)
set_target_properties(etlforge_studio_javascript PROPERTIES OUTPUT_NAME ETLForgeJavaScript)
set(ETLFORGE_JAVASCRIPT_STAGE_BIN "" CACHE PATH "Optional staging directory for reviewed server deployment")
if(ETLFORGE_JAVASCRIPT_STAGE_BIN)
 foreach(component etlforge_runtime_pluginmanager etlforge_process_engine etlforge_scheduler etlforge_operation_worker etlforge_cleanup etlforge_control etlforge_frontend_treemapperinfoprovider etlforge_frontend_deployinterchangedata etlforge_frontend_projectadministration etlforge_frontend_admin etlforge_authenticate etlforge_frontend_checkoutinterchangedata etlforge_frontend_activity etlforge_frontend_jobcontrol etlforge_frontend_filemanagement etlforge_frontend_xmlinfoprovider etlforge_frontend_odbcinfoprovider etlforge_frontend_testconnection etlforge_frontend_webserviceinfoprovider etlforge_frontend_pluginmanagement etlforge_frontend_useradmin)
  set_target_properties(${component} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${ETLFORGE_JAVASCRIPT_STAGE_BIN}")
 endforeach()
endif()
if(BUILD_TESTING)
 add_executable(etlforge_javascript_tests tests/native/javascript_tests.cpp)
 target_link_libraries(etlforge_javascript_tests PRIVATE etlforge_native_javascript)
 target_compile_options(etlforge_javascript_tests PRIVATE /utf-8)
 add_test(NAME native.javascript COMMAND etlforge_javascript_tests)
 add_executable(etlforge_javascript_benchmark EXCLUDE_FROM_ALL tests/native/javascript_benchmark.cpp)
 target_link_libraries(etlforge_javascript_benchmark PRIVATE etlforge_native_javascript psapi)
endif()
if(ETLFORGE_JAVASCRIPT_STAGE_BIN)
 set_target_properties(etlforge_hosted_webservice PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${ETLFORGE_JAVASCRIPT_STAGE_BIN}" LIBRARY_OUTPUT_DIRECTORY "${ETLFORGE_JAVASCRIPT_STAGE_BIN}")
endif()
