find_program(ETLFORGE_MIDL midl REQUIRED)
set(service_source "${ETLFORGE_INTEGRATION}/konga/PlatformSpecific/Win32/Services/CleanupService")
set(service_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/CleanupService")
file(MAKE_DIRECTORY "${service_generated}")
add_custom_command(OUTPUT "${service_generated}/CleanupService.h" "${service_generated}/CleanupService_i.c" "${service_generated}/CleanupService.tlb"  COMMAND "${ETLFORGE_MIDL}" /nologo /env x64 /h CleanupService.h /iid CleanupService_i.c /tlb CleanupService.tlb /out "${service_generated}" "${service_source}/CleanupService.idl"  DEPENDS "${service_source}/CleanupService.idl" VERBATIM)
set_source_files_properties("${service_generated}/CleanupService_i.c" PROPERTIES LANGUAGE CXX)
add_library(etlforge_cleanupservice_probe STATIC EXCLUDE_FROM_ALL "${service_source}/CleanupService.cpp" "${service_generated}/CleanupService_i.c")
target_include_directories(etlforge_cleanupservice_probe PRIVATE "${service_generated}" "${ETLFORGE_COMMON}" "${ETLFORGE_INTEGRATION}" C:/ETL/Dependencies/boost_1_86_0)
target_compile_definitions(etlforge_cleanupservice_probe PRIVATE WIN32 NOMINMAX _WIN32_WINNT=0x0602 WINVER=0x0602 _WIN32_IE=0x0600 _CRT_SECURE_NO_WARNINGS BOOST_ALL_NO_LIB)
