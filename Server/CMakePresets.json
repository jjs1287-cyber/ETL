{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "ETLForge Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
