# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-filetransfer-d.so
CFG_INC=-I$(SAMBA_INCLUDE) 
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-crypto-d \
	-lkonga-mime-d -lkonga-networking-d -lkonga-sysinfo-d \
	-lkonga-utils-d -lcurl $(SAMBA_LIBDIR) -lsmbclient 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CurlTransferLibWrapper.o \
	$(OUTDIR)/FileRetriever.o $(OUTDIR)/Ftp.o $(OUTDIR)/ftpparse.o \
	$(OUTDIR)/Http.o $(OUTDIR)/HttpBase.o $(OUTDIR)/HttpOptions.o \
	$(OUTDIR)/Https.o $(OUTDIR)/InetBase.o $(OUTDIR)/Protocol.o \
	$(OUTDIR)/Samba.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CurlTransferLibWrapper.o $(OUTDIR)/FileRetriever.o \
	$(OUTDIR)/Ftp.o $(OUTDIR)/ftpparse.o $(OUTDIR)/Http.o \
	$(OUTDIR)/HttpBase.o $(OUTDIR)/HttpOptions.o $(OUTDIR)/Https.o \
	$(OUTDIR)/InetBase.o $(OUTDIR)/Protocol.o $(OUTDIR)/Samba.o \
	-L../../../../../../lib/konga/ -lkonga-crypto-d -lkonga-mime-d \
	-lkonga-networking-d -lkonga-sysinfo-d -lkonga-utils-d -lcurl \
	$(SAMBA_LIBDIR) -lsmbclient 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-filetransfer-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-filetransfer.so
CFG_INC=-I$(SAMBA_INCLUDE) 
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-crypto -lkonga-mime \
	-lkonga-networking -lkonga-sysinfo -lkonga-utils -lcurl \
	$(SAMBA_LIBDIR) -lsmbclient 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CurlTransferLibWrapper.o \
	$(OUTDIR)/FileRetriever.o $(OUTDIR)/Ftp.o $(OUTDIR)/ftpparse.o \
	$(OUTDIR)/Http.o $(OUTDIR)/HttpBase.o $(OUTDIR)/HttpOptions.o \
	$(OUTDIR)/Https.o $(OUTDIR)/InetBase.o $(OUTDIR)/Protocol.o \
	$(OUTDIR)/Samba.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CurlTransferLibWrapper.o $(OUTDIR)/FileRetriever.o \
	$(OUTDIR)/Ftp.o $(OUTDIR)/ftpparse.o $(OUTDIR)/Http.o \
	$(OUTDIR)/HttpBase.o $(OUTDIR)/HttpOptions.o $(OUTDIR)/Https.o \
	$(OUTDIR)/InetBase.o $(OUTDIR)/Protocol.o $(OUTDIR)/Samba.o \
	-L../../../../../../lib/konga/ -lkonga-crypto -lkonga-mime \
	-lkonga-networking -lkonga-sysinfo -lkonga-utils -lcurl \
	$(SAMBA_LIBDIR) -lsmbclient 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-filetransfer.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
