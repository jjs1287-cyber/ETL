# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-xml-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-utils-d -lxerces-c \
	-lxalan-c 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CrXmlException.o $(OUTDIR)/DOMAttrPtr.o \
	$(OUTDIR)/DOMCDATASectionPtr.o $(OUTDIR)/DOMCharacterDataPtr.o \
	$(OUTDIR)/DOMDocument_ptr.o $(OUTDIR)/DOMDocumentPtr.o \
	$(OUTDIR)/DOMDocumentTypePtr.o $(OUTDIR)/DOMElementListPtr.o \
	$(OUTDIR)/DOMElementPtr.o $(OUTDIR)/DOMNamedNodeMapPtr.o \
	$(OUTDIR)/DOMNodeListPtr.o $(OUTDIR)/DOMNodePtr.o \
	$(OUTDIR)/DOMProcessingInstructionPtr.o $(OUTDIR)/DOMTextPtr.o \
	$(OUTDIR)/RCDocPtr.o $(OUTDIR)/SimpleDOMErrorHandler.o \
	$(OUTDIR)/SimpleSAXHandler.o $(OUTDIR)/XercesXmlUtils.o \
	$(OUTDIR)/XmlNamespaceDeclarations.o $(OUTDIR)/XMLOstreamWriter.o \
	$(OUTDIR)/XmlParsingErrors.o $(OUTDIR)/XmlSchemaUtils.o \
	$(OUTDIR)/XmlSchemaValidator.o $(OUTDIR)/XmlStringBuilder.o \
	$(OUTDIR)/XmlUtils.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CrXmlException.o $(OUTDIR)/DOMAttrPtr.o \
	$(OUTDIR)/DOMCDATASectionPtr.o $(OUTDIR)/DOMCharacterDataPtr.o \
	$(OUTDIR)/DOMDocument_ptr.o $(OUTDIR)/DOMDocumentPtr.o \
	$(OUTDIR)/DOMDocumentTypePtr.o $(OUTDIR)/DOMElementListPtr.o \
	$(OUTDIR)/DOMElementPtr.o $(OUTDIR)/DOMNamedNodeMapPtr.o \
	$(OUTDIR)/DOMNodeListPtr.o $(OUTDIR)/DOMNodePtr.o \
	$(OUTDIR)/DOMProcessingInstructionPtr.o $(OUTDIR)/DOMTextPtr.o \
	$(OUTDIR)/RCDocPtr.o $(OUTDIR)/SimpleDOMErrorHandler.o \
	$(OUTDIR)/SimpleSAXHandler.o $(OUTDIR)/XercesXmlUtils.o \
	$(OUTDIR)/XmlNamespaceDeclarations.o $(OUTDIR)/XMLOstreamWriter.o \
	$(OUTDIR)/XmlParsingErrors.o $(OUTDIR)/XmlSchemaUtils.o \
	$(OUTDIR)/XmlSchemaValidator.o $(OUTDIR)/XmlStringBuilder.o \
	$(OUTDIR)/XmlUtils.o -L../../../../../../lib/konga/ -lkonga-utils-d \
	-lxerces-c -lxalan-c 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-xml-d.so ../../../../../../lib/konga

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-xml.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-utils -lxerces-c \
	-lxalan-c 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CrXmlException.o $(OUTDIR)/DOMAttrPtr.o \
	$(OUTDIR)/DOMCDATASectionPtr.o $(OUTDIR)/DOMCharacterDataPtr.o \
	$(OUTDIR)/DOMDocument_ptr.o $(OUTDIR)/DOMDocumentPtr.o \
	$(OUTDIR)/DOMDocumentTypePtr.o $(OUTDIR)/DOMElementListPtr.o \
	$(OUTDIR)/DOMElementPtr.o $(OUTDIR)/DOMNamedNodeMapPtr.o \
	$(OUTDIR)/DOMNodeListPtr.o $(OUTDIR)/DOMNodePtr.o \
	$(OUTDIR)/DOMProcessingInstructionPtr.o $(OUTDIR)/DOMTextPtr.o \
	$(OUTDIR)/RCDocPtr.o $(OUTDIR)/SimpleDOMErrorHandler.o \
	$(OUTDIR)/SimpleSAXHandler.o $(OUTDIR)/XercesXmlUtils.o \
	$(OUTDIR)/XmlNamespaceDeclarations.o $(OUTDIR)/XMLOstreamWriter.o \
	$(OUTDIR)/XmlParsingErrors.o $(OUTDIR)/XmlSchemaUtils.o \
	$(OUTDIR)/XmlSchemaValidator.o $(OUTDIR)/XmlStringBuilder.o \
	$(OUTDIR)/XmlUtils.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CrXmlException.o $(OUTDIR)/DOMAttrPtr.o \
	$(OUTDIR)/DOMCDATASectionPtr.o $(OUTDIR)/DOMCharacterDataPtr.o \
	$(OUTDIR)/DOMDocument_ptr.o $(OUTDIR)/DOMDocumentPtr.o \
	$(OUTDIR)/DOMDocumentTypePtr.o $(OUTDIR)/DOMElementListPtr.o \
	$(OUTDIR)/DOMElementPtr.o $(OUTDIR)/DOMNamedNodeMapPtr.o \
	$(OUTDIR)/DOMNodeListPtr.o $(OUTDIR)/DOMNodePtr.o \
	$(OUTDIR)/DOMProcessingInstructionPtr.o $(OUTDIR)/DOMTextPtr.o \
	$(OUTDIR)/RCDocPtr.o $(OUTDIR)/SimpleDOMErrorHandler.o \
	$(OUTDIR)/SimpleSAXHandler.o $(OUTDIR)/XercesXmlUtils.o \
	$(OUTDIR)/XmlNamespaceDeclarations.o $(OUTDIR)/XMLOstreamWriter.o \
	$(OUTDIR)/XmlParsingErrors.o $(OUTDIR)/XmlSchemaUtils.o \
	$(OUTDIR)/XmlSchemaValidator.o $(OUTDIR)/XmlStringBuilder.o \
	$(OUTDIR)/XmlUtils.o -L../../../../../../lib/konga/ -lkonga-utils \
	-lxerces-c -lxalan-c 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-xml.so ../../../../../../lib/konga

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
