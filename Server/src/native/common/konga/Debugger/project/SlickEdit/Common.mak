# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----

# -----End user-editable area-----

# If no configuration is specified, "Release" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/Common
CFG_INC=
CFG_LIB=
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/Common.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/Common.o 

COMPILE=g++ -c    -g -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -g -o "$(OUTFILE)" $(OBJ) $(CFG_LIB)

# Pattern rules
$(OUTDIR)/%.o : %.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR) deps $(OBJ)
	$(LINK)

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Build dependencies
deps:
	@(cd ../../Crypto/project/SlickEdit/;$(MAKE) -f Crypto.mak CFG=$(CFG))
	@(cd ../../FileTransfer/project/SlickEdit/;$(MAKE) -f FileTransfer.mak CFG=$(CFG))
	@(cd ../../Ldap/project/SlickEdit/;$(MAKE) -f Ldap.mak CFG=$(CFG))
	@(cd ../../Log/project/SlickEdit/;$(MAKE) -f Log.mak CFG=$(CFG))
	@(cd ../../MailClient/project/SlickEdit/;$(MAKE) -f MailClient.mak CFG=$(CFG))
	@(cd ../../Mime/project/SlickEdit/;$(MAKE) -f Mime.mak CFG=$(CFG))
	@(cd ../../Networking/project/SlickEdit/;$(MAKE) -f Networking.mak CFG=$(CFG))
	@(cd ../../Soap/project/SlickEdit/;$(MAKE) -f Soap.mak CFG=$(CFG))
	@(cd ../../Utils/project/SlickEdit/;$(MAKE) -f Utils.mak CFG=$(CFG))
	@(cd ../../WebService/project/SlickEdit/;$(MAKE) -f WebService.mak CFG=$(CFG))
	@(cd ../../Xml/project/SlickEdit/;$(MAKE) -f Xml.mak CFG=$(CFG))
	@(cd ../../Zip/project/SlickEdit/;$(MAKE) -f Zip.mak CFG=$(CFG))
	@(cd ../../CharacterEncodingConversion/project/SlickEdit/;$(MAKE) -f CharacterEncodingConversion.mak CFG=$(CFG))
	@(cd ../../SysInfo/project/SlickEdit/;$(MAKE) -f SysInfo.mak CFG=$(CFG))
	@(cd ../../Debugger/project/SlickEdit/;$(MAKE) -f Debugger.mak CFG=$(CFG))

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
	@(cd ../../Crypto/project/SlickEdit/;$(MAKE) -f Crypto.mak cleanall CFG=$(CFG))
	@(cd ../../FileTransfer/project/SlickEdit/;$(MAKE) -f FileTransfer.mak cleanall CFG=$(CFG))
	@(cd ../../Ldap/project/SlickEdit/;$(MAKE) -f Ldap.mak cleanall CFG=$(CFG))
	@(cd ../../Log/project/SlickEdit/;$(MAKE) -f Log.mak cleanall CFG=$(CFG))
	@(cd ../../MailClient/project/SlickEdit/;$(MAKE) -f MailClient.mak cleanall CFG=$(CFG))
	@(cd ../../Mime/project/SlickEdit/;$(MAKE) -f Mime.mak cleanall CFG=$(CFG))
	@(cd ../../Networking/project/SlickEdit/;$(MAKE) -f Networking.mak cleanall CFG=$(CFG))
	@(cd ../../Soap/project/SlickEdit/;$(MAKE) -f Soap.mak cleanall CFG=$(CFG))
	@(cd ../../Utils/project/SlickEdit/;$(MAKE) -f Utils.mak cleanall CFG=$(CFG))
	@(cd ../../WebService/project/SlickEdit/;$(MAKE) -f WebService.mak cleanall CFG=$(CFG))
	@(cd ../../Xml/project/SlickEdit/;$(MAKE) -f Xml.mak cleanall CFG=$(CFG))
	@(cd ../../Zip/project/SlickEdit/;$(MAKE) -f Zip.mak cleanall CFG=$(CFG))
	@(cd ../../CharacterEncodingConversion/project/SlickEdit/;$(MAKE) -f CharacterEncodingConversion.mak cleanall CFG=$(CFG))
	@(cd ../../SysInfo/project/SlickEdit/;$(MAKE) -f SysInfo.mak cleanall CFG=$(CFG))
	@(cd ../../Debugger/project/SlickEdit/;$(MAKE) -f Debugger.mak cleanall CFG=$(CFG))
endif

