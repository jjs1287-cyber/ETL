# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-networking-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-log-d -lkonga-utils-d \
	$(LIB_SOCKET) 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/AutoCleanupNetworking.o \
	$(OUTDIR)/BasicCommands.o $(OUTDIR)/CommandListenerUsingSockets.o \
	$(OUTDIR)/CommandUtils.o $(OUTDIR)/Communicator.o \
	$(OUTDIR)/CrStreamSocket.o $(OUTDIR)/IPUtils.o $(OUTDIR)/Packet.o \
	$(OUTDIR)/Request.o $(OUTDIR)/Response.o \
	$(OUTDIR)/ServerStreamSocket.o $(OUTDIR)/SockProtocol.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/AutoCleanupNetworking.o $(OUTDIR)/BasicCommands.o \
	$(OUTDIR)/CommandListenerUsingSockets.o $(OUTDIR)/CommandUtils.o \
	$(OUTDIR)/Communicator.o $(OUTDIR)/CrStreamSocket.o \
	$(OUTDIR)/IPUtils.o $(OUTDIR)/Packet.o $(OUTDIR)/Request.o \
	$(OUTDIR)/Response.o $(OUTDIR)/ServerStreamSocket.o \
	$(OUTDIR)/SockProtocol.o -L../../../../../../lib/konga/ \
	-lkonga-log-d -lkonga-utils-d $(LIB_SOCKET) 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-networking-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-networking.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-log -lkonga-utils \
	$(LIB_SOCKET) 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/AutoCleanupNetworking.o \
	$(OUTDIR)/BasicCommands.o $(OUTDIR)/CommandListenerUsingSockets.o \
	$(OUTDIR)/CommandUtils.o $(OUTDIR)/Communicator.o \
	$(OUTDIR)/CrStreamSocket.o $(OUTDIR)/IPUtils.o $(OUTDIR)/Packet.o \
	$(OUTDIR)/Request.o $(OUTDIR)/Response.o \
	$(OUTDIR)/ServerStreamSocket.o $(OUTDIR)/SockProtocol.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/AutoCleanupNetworking.o $(OUTDIR)/BasicCommands.o \
	$(OUTDIR)/CommandListenerUsingSockets.o $(OUTDIR)/CommandUtils.o \
	$(OUTDIR)/Communicator.o $(OUTDIR)/CrStreamSocket.o \
	$(OUTDIR)/IPUtils.o $(OUTDIR)/Packet.o $(OUTDIR)/Request.o \
	$(OUTDIR)/Response.o $(OUTDIR)/ServerStreamSocket.o \
	$(OUTDIR)/SockProtocol.o -L../../../../../../lib/konga/ -lkonga-log \
	-lkonga-utils $(LIB_SOCKET) 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-networking.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
