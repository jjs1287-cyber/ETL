# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-utils-d.so
CFG_INC=
CFG_LIB=-lboost_system-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d \
	-lboost_thread-$(BOOST_LIB_TAG)-d \
	-lboost_filesystem-$(BOOST_LIB_TAG)-d \
	-lboost_regex-$(BOOST_LIB_TAG)-d -lxerces-c -lxalan-c -luuid 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/PortDefs.o $(OUTDIR)/AutoFileCleanup.o \
	$(OUTDIR)/BinaryData.o $(OUTDIR)/BinaryDataFileIo.o \
	$(OUTDIR)/CancelHandlers.o $(OUTDIR)/CsvUtils.o $(OUTDIR)/date.o \
	$(OUTDIR)/DateUtils.o $(OUTDIR)/DBConnectionInfo.o \
	$(OUTDIR)/DbTypeUtils.o $(OUTDIR)/EbcdicToAscii.o \
	$(OUTDIR)/ErrorResolver.o $(OUTDIR)/ExecuteCommand.o \
	$(OUTDIR)/FileContents.o $(OUTDIR)/FileLineReadWriter.o \
	$(OUTDIR)/FilesTraverser.o $(OUTDIR)/FileTokenizer.o \
	$(OUTDIR)/FileUtils.o $(OUTDIR)/HashTable.o $(OUTDIR)/KeyValues.o \
	$(OUTDIR)/KString.o $(OUTDIR)/LoadDBConnectionInfo.o \
	$(OUTDIR)/MemUtils.o $(OUTDIR)/ObjectAccessControl.o \
	$(OUTDIR)/OdbcConnectionStringUtils.o $(OUTDIR)/ProcessUtils.o \
	$(OUTDIR)/Random.o $(OUTDIR)/RCStringTable.o $(OUTDIR)/RegExUtils.o \
	$(OUTDIR)/Settings.o $(OUTDIR)/SimpleFileFilterFileMatcher.o \
	$(OUTDIR)/StringBuilder.o $(OUTDIR)/StringTokenizer.o \
	$(OUTDIR)/StringUtils.o $(OUTDIR)/ThreadUtils.o $(OUTDIR)/Timer.o \
	$(OUTDIR)/Timing.o $(OUTDIR)/Url.o $(OUTDIR)/util.o \
	$(OUTDIR)/VectorUtils.o $(OUTDIR)/Version.o $(OUTDIR)/XmlInit.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/PortDefs.o $(OUTDIR)/AutoFileCleanup.o \
	$(OUTDIR)/BinaryData.o $(OUTDIR)/BinaryDataFileIo.o \
	$(OUTDIR)/CancelHandlers.o $(OUTDIR)/CsvUtils.o $(OUTDIR)/date.o \
	$(OUTDIR)/DateUtils.o $(OUTDIR)/DBConnectionInfo.o \
	$(OUTDIR)/DbTypeUtils.o $(OUTDIR)/EbcdicToAscii.o \
	$(OUTDIR)/ErrorResolver.o $(OUTDIR)/ExecuteCommand.o \
	$(OUTDIR)/FileContents.o $(OUTDIR)/FileLineReadWriter.o \
	$(OUTDIR)/FilesTraverser.o $(OUTDIR)/FileTokenizer.o \
	$(OUTDIR)/FileUtils.o $(OUTDIR)/HashTable.o $(OUTDIR)/KeyValues.o \
	$(OUTDIR)/KString.o $(OUTDIR)/LoadDBConnectionInfo.o \
	$(OUTDIR)/MemUtils.o $(OUTDIR)/ObjectAccessControl.o \
	$(OUTDIR)/OdbcConnectionStringUtils.o $(OUTDIR)/ProcessUtils.o \
	$(OUTDIR)/Random.o $(OUTDIR)/RCStringTable.o $(OUTDIR)/RegExUtils.o \
	$(OUTDIR)/Settings.o $(OUTDIR)/SimpleFileFilterFileMatcher.o \
	$(OUTDIR)/StringBuilder.o $(OUTDIR)/StringTokenizer.o \
	$(OUTDIR)/StringUtils.o $(OUTDIR)/ThreadUtils.o $(OUTDIR)/Timer.o \
	$(OUTDIR)/Timing.o $(OUTDIR)/Url.o $(OUTDIR)/util.o \
	$(OUTDIR)/VectorUtils.o $(OUTDIR)/Version.o $(OUTDIR)/XmlInit.o \
	-lboost_system-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d \
	-lboost_thread-$(BOOST_LIB_TAG)-d \
	-lboost_filesystem-$(BOOST_LIB_TAG)-d \
	-lboost_regex-$(BOOST_LIB_TAG)-d -lxerces-c -lxalan-c -luuid 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../PlatformSpecific/Unix/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-utils-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

