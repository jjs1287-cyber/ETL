# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-mailclient-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-sysinfo-d \
	-lkonga-utils-d -lcclient -lpam $(OPENSSL_LIBDIR) -lcrypto -lssl 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/EmailAddress.o $(OUTDIR)/EmailProperties.o \
	$(OUTDIR)/rfc822Date.o $(OUTDIR)/SmtpClient.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/EmailAddress.o $(OUTDIR)/EmailProperties.o \
	$(OUTDIR)/rfc822Date.o $(OUTDIR)/SmtpClient.o \
	-L../../../../../../lib/konga -lkonga-sysinfo-d -lkonga-utils-d \
	-lcclient -lpam $(OPENSSL_LIBDIR) -lcrypto -lssl 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -fno-operator-names
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ) -mimpure-text

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-mailclient-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-mailclient.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-sysinfo -lkonga-utils \
	-lcclient -lpam $(OPENSSL_LIBDIR) -lcrypto -lssl 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/EmailAddress.o $(OUTDIR)/EmailProperties.o \
	$(OUTDIR)/rfc822Date.o $(OUTDIR)/SmtpClient.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/EmailAddress.o $(OUTDIR)/EmailProperties.o \
	$(OUTDIR)/rfc822Date.o $(OUTDIR)/SmtpClient.o \
	-L../../../../../../lib/konga -lkonga-sysinfo -lkonga-utils \
	-lcclient -lpam $(OPENSSL_LIBDIR) -lcrypto -lssl 

COMPILE=g++ -c   -O2 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -fno-operator-names
LINK=g++  -O2 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ) -mimpure-text

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-mailclient.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
