# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/ETLForgeUtils
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-dbmaintenance-d \
	-lkonga-dbutils-d -lkonga-guidmappings-d -lkonga-messaging-d \
	-lkonga-networking-d -lkonga-server-d -lkonga-trandb-d \
	-lkonga-uploadedfilesmanager-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/HttpProxyConfig.o \
	$(OUTDIR)/ETLForgeUtilsCommands.o $(OUTDIR)/ETLForgeUtilsDb.o \
	$(OUTDIR)/ETLForgeUtilsJUEIP.o $(OUTDIR)/ETLForgeUtilsMain.o \
	$(OUTDIR)/ETLForgeUtilsOperation.o $(OUTDIR)/ListOperations.o \
	$(OUTDIR)/ServerLabel.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/HttpProxyConfig.o \
	$(OUTDIR)/ETLForgeUtilsCommands.o $(OUTDIR)/ETLForgeUtilsDb.o \
	$(OUTDIR)/ETLForgeUtilsJUEIP.o $(OUTDIR)/ETLForgeUtilsMain.o \
	$(OUTDIR)/ETLForgeUtilsOperation.o $(OUTDIR)/ListOperations.o \
	$(OUTDIR)/ServerLabel.o -L../../../../../../lib/konga \
	-lkonga-dbmaintenance-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-messaging-d -lkonga-networking-d -lkonga-server-d \
	-lkonga-trandb-d -lkonga-uploadedfilesmanager-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeUtils ../../../../../../bin/konga/Debug/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/ETLForgeUtils
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-dbmaintenance \
	-lkonga-dbutils -lkonga-guidmappings -lkonga-messaging \
	-lkonga-networking -lkonga-server -lkonga-trandb \
	-lkonga-uploadedfilesmanager -lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/HttpProxyConfig.o \
	$(OUTDIR)/ETLForgeUtilsCommands.o $(OUTDIR)/ETLForgeUtilsDb.o \
	$(OUTDIR)/ETLForgeUtilsJUEIP.o $(OUTDIR)/ETLForgeUtilsMain.o \
	$(OUTDIR)/ETLForgeUtilsOperation.o $(OUTDIR)/ListOperations.o \
	$(OUTDIR)/ServerLabel.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/HttpProxyConfig.o \
	$(OUTDIR)/ETLForgeUtilsCommands.o $(OUTDIR)/ETLForgeUtilsDb.o \
	$(OUTDIR)/ETLForgeUtilsJUEIP.o $(OUTDIR)/ETLForgeUtilsMain.o \
	$(OUTDIR)/ETLForgeUtilsOperation.o $(OUTDIR)/ListOperations.o \
	$(OUTDIR)/ServerLabel.o -L../../../../../../lib/konga \
	-lkonga-dbmaintenance -lkonga-dbutils -lkonga-guidmappings \
	-lkonga-messaging -lkonga-networking -lkonga-server -lkonga-trandb \
	-lkonga-uploadedfilesmanager -lkonga-utils 

COMPILE=g++ -c   -O2 -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O2 -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeUtils ../../../../../../bin/konga/Release/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
