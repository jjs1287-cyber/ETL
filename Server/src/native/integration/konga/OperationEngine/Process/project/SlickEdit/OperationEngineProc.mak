# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/ETLForgeOperationEngineProc
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-log-d \
	-lkonga-operationengine-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/OperationEngineProc.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/OperationEngineProc.o \
	-L../../../../../../../lib/konga -lkonga-log-d \
	-lkonga-operationengine-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeOperationEngineProc ../../../../../../../bin/konga/Debug/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/ETLForgeOperationEngineProc
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-log \
	-lkonga-operationengine -lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/OperationEngineProc.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/OperationEngineProc.o \
	-L../../../../../../../lib/konga -lkonga-log -lkonga-operationengine \
	-lkonga-utils 

COMPILE=g++ -c   -O3 -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O3 -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeOperationEngineProc ../../../../../../../bin/konga/Release/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
