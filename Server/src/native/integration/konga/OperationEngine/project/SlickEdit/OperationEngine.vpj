	</Config>
	<Files>
		<Folder
			Name="Header Files"
			Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.inc;*.sh;*.cpy;*.if">
			<F N="../../DebugLog.h"/>
			<F N="../../OperationCreatorDb.h"/>
			<F N="../../OperationEngine.h"/>
			<F N="../../OperationEngineDataElementHolder.h"/>
			<F N="../../OperationScriptRunner.h"/>
			<F N="../../OperationUtils.h"/>
			<F N="../../SignalHandler.h"/>
			<F N="../../TestOperationDataFile.h"/>
			<F N="../../TransformationOperation.h"/>
		</Folder>
		<Folder
			Name="Source Files"
			Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl">
			<F N="../../HandleWebServiceCallImpl.cpp"/>
			<F N="../../OperationCreatorDb.cpp"/>
			<F N="../../OperationEngine.cpp"/>
			<F N="../../OperationEngineDataElements.cpp"/>
			<F N="../../OperationEngineFinalProcessing.cpp"/>
			<F N="../../OperationEngineNextOperation.cpp"/>
			<F N="../../OperationScriptRunner.cpp"/>
			<F N="../../OperationUtils.cpp"/>
			<F N="../../SignalHandler.cpp"/>
			<F N="../../TestOperationImpl.cpp"/>
			<F N="../../TransformationOperation.cpp"/>
		</Folder>
		<F
			N="OperationEngine.mak"
			Type="Makefile"/>
	</Files>
	<CompatibleVersions>
