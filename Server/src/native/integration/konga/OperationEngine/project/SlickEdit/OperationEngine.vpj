<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/10.0/vpj.dtd">
<Project
	Version="10.0"
	VendorName="SlickEdit"
	WorkingDir="."
	BuildSystem="automakefile"
	BuildMakeFile="%rp%rn.mak">
	<Config
		Name="Debug"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-operationengine-d.so"
		CompilerConfigName="Default Compiler"
		Defines='"/D_DEBUG"'>
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O0 -g -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O0 -g -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
		</Includes>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../lib/konga"/>
			<Lib File="-lkonga-crypto-d"/>
			<Lib File="-lkonga-dataelement-d"/>
			<Lib File="-lkonga-dbrelations-d"/>
			<Lib File="-lkonga-dbutils-d"/>
			<Lib File="-lkonga-itemaccess-d"/>
			<Lib File="-lkonga-log-d"/>
			<Lib File="-lkonga-messaging-d"/>
			<Lib File="-lkonga-operationcontext-d"/>
			<Lib File="-lkonga-operationdataelements-d"/>
			<Lib File="-lkonga-operationlog-d"/>
			<Lib File="-lkonga-operationobjects-d"/>
			<Lib File="-lkonga-operationpipeline-d"/>
			<Lib File="-lkonga-pipelinepluginexecutor-d"/>
			<Lib File="-lkonga-pluginmanager-d"/>
			<Lib File="-lkonga-server-d"/>
			<Lib File="-lkonga-soap-d"/>
			<Lib File="-lkonga-trandb-d"/>
			<Lib File="-lkonga-transformationengine-d"/>
			<Lib File="-lkonga-transformationutils-d"/>
			<Lib File="-lkonga-utils-d"/>
			<Lib File="-lkonga-xml-d"/>
			<Lib File="-lboost_regex-$(BOOST_LIB_TAG)-d"/>
			<Lib File="-lboost_date_time-$(BOOST_LIB_TAG)-d"/>
		</Libs>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-operationengine-d.so ../../../../../../lib/konga/"/>
		</PostBuildCommands>
	</Config>
	<Config
		Name="Release"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-operationengine.so"
		CompilerConfigName="Default Compiler"
		Defines="">
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O3 -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O3 -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
		</Includes>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../lib/konga"/>
			<Lib File="-lkonga-crypto"/>
			<Lib File="-lkonga-dataelement"/>
			<Lib File="-lkonga-dbrelations"/>
			<Lib File="-lkonga-dbutils"/>
			<Lib File="-lkonga-itemaccess"/>
			<Lib File="-lkonga-log"/>
			<Lib File="-lkonga-messaging"/>
			<Lib File="-lkonga-operationcontext"/>
			<Lib File="-lkonga-operationdataelements"/>
			<Lib File="-lkonga-operationlog"/>
			<Lib File="-lkonga-operationobjects"/>
			<Lib File="-lkonga-operationpipeline"/>
			<Lib File="-lkonga-pipelinepluginexecutor"/>
			<Lib File="-lkonga-pluginmanager"/>
			<Lib File="-lkonga-server"/>
			<Lib File="-lkonga-soap"/>
			<Lib File="-lkonga-trandb"/>
			<Lib File="-lkonga-transformationengine"/>
			<Lib File="-lkonga-transformationutils"/>
			<Lib File="-lkonga-utils"/>
			<Lib File="-lkonga-xml"/>
			<Lib File="-lboost_regex-$(BOOST_LIB_TAG)"/>
			<Lib File="-lboost_date_time-$(BOOST_LIB_TAG)"/>
		</Libs>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-operationengine.so ../../../../../../lib/konga/"/>
		</PostBuildCommands>
	</Config>
	<Config
		Name="Private_Release"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-operationengine.so"
		CompilerConfigName="Default Compiler"
		Defines="">
