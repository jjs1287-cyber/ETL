# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-operationengine-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dataelement-d -lkonga-dbrelations-d -lkonga-dbutils-d \
	-lkonga-itemaccess-d -lkonga-log-d -lkonga-messaging-d \
	-lkonga-operationcontext-d -lkonga-operationdataelements-d \
	-lkonga-operationlog-d -lkonga-operationobjects-d \
	-lkonga-operationpipeline-d -lkonga-pipelinepluginexecutor-d \
	-lkonga-pluginmanager-d -lkonga-server-d -lkonga-soap-d \
	-lkonga-trandb-d -lkonga-transformationengine-d \
	-lkonga-transformationutils-d -lkonga-utils-d -lkonga-xml-d \
	-lboost_regex-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/HandleWebServiceCallImpl.o \
	$(OUTDIR)/OperationCreatorDb.o $(OUTDIR)/OperationEngine.o \
	$(OUTDIR)/OperationEngineDataElements.o \
	$(OUTDIR)/OperationEngineFinalProcessing.o \
	$(OUTDIR)/OperationEngineNextOperation.o \
	$(OUTDIR)/OperationScriptRunner.o $(OUTDIR)/OperationUtils.o \
	$(OUTDIR)/SignalHandler.o $(OUTDIR)/TestOperationImpl.o \
	$(OUTDIR)/TransformationOperation.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/HandleWebServiceCallImpl.o \
	$(OUTDIR)/OperationCreatorDb.o $(OUTDIR)/OperationEngine.o \
	$(OUTDIR)/OperationEngineDataElements.o \
	$(OUTDIR)/OperationEngineFinalProcessing.o \
	$(OUTDIR)/OperationEngineNextOperation.o \
	$(OUTDIR)/OperationScriptRunner.o $(OUTDIR)/OperationUtils.o \
	$(OUTDIR)/SignalHandler.o $(OUTDIR)/TestOperationImpl.o \
	$(OUTDIR)/TransformationOperation.o -L../../../../../../lib/konga \
	-lkonga-crypto-d -lkonga-dataelement-d -lkonga-dbrelations-d \
	-lkonga-dbutils-d -lkonga-itemaccess-d -lkonga-log-d \
	-lkonga-messaging-d -lkonga-operationcontext-d \
	-lkonga-operationdataelements-d -lkonga-operationlog-d \
	-lkonga-operationobjects-d -lkonga-operationpipeline-d \
	-lkonga-pipelinepluginexecutor-d -lkonga-pluginmanager-d \
	-lkonga-server-d -lkonga-soap-d -lkonga-trandb-d \
	-lkonga-transformationengine-d -lkonga-transformationutils-d \
	-lkonga-utils-d -lkonga-xml-d -lboost_regex-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-operationengine-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

