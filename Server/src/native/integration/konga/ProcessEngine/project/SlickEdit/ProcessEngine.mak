# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/ETLForgeProcessEngine
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-dbmaintenance-d \
	-lkonga-dbutils-d -lkonga-filetransfer-d -lkonga-guidmappings-d \
	-lkonga-idb-d -lkonga-itemaccess-d -lkonga-log-d -lkonga-mime-d \
	-lkonga-msgdb-d -lkonga-networking-d -lkonga-operationengine-d \
	-lkonga-operationlog-d -lkonga-pdb-d -lkonga-pluginmanager-d \
	-lkonga-server-d -lkonga-serverversion-d -lkonga-sysinfo-d \
	-lkonga-trandb-d -lkonga-transformationengine-d -lkonga-utils-d \
	-lkonga-workflow-d -lboost_thread-$(BOOST_LIB_TAG)-d \
	-lboost_filesystem-$(BOOST_LIB_TAG)-d -lodbc 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/BindParam.o $(OUTDIR)/SpCaller.o \
	$(OUTDIR)/SpException.o $(OUTDIR)/msgrCore.o $(OUTDIR)/parseSMTP.o \
	$(OUTDIR)/ActivityEngineCore.o $(OUTDIR)/com_caller.o \
	$(OUTDIR)/ComCallerRemote.o $(OUTDIR)/corba_caller.o \
	$(OUTDIR)/corba_util.o $(OUTDIR)/ejb_caller.o \
	$(OUTDIR)/ejb_corba_srv.o $(OUTDIR)/engine_util.o \
	$(OUTDIR)/EngineCore.o $(OUTDIR)/EngineDebugUtils.o \
	$(OUTDIR)/FaultToleranceEngineCore.o $(OUTDIR)/FaultTolerantObject.o \
	$(OUTDIR)/IncomingMsg.o $(OUTDIR)/InstanceEngineCore.o \
	$(OUTDIR)/IRBrowser.o $(OUTDIR)/LDAPWrapper.o \
	$(OUTDIR)/ObjectAccessControl.o $(OUTDIR)/RoutingEngineCore.o \
	$(OUTDIR)/script.o $(OUTDIR)/SoapCaller.o $(OUTDIR)/SoapException.o \
	$(OUTDIR)/SoapPacket.o $(OUTDIR)/TaskDataElement.o \
	$(OUTDIR)/ThreadData.o $(OUTDIR)/ThreadManager.o \
	$(OUTDIR)/UtilityEngineCore.o $(OUTDIR)/ValidationEngineCore.o \
	$(OUTDIR)/Globals.o $(OUTDIR)/ProcessEngine.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/BindParam.o $(OUTDIR)/SpCaller.o \
	$(OUTDIR)/SpException.o $(OUTDIR)/msgrCore.o $(OUTDIR)/parseSMTP.o \
	$(OUTDIR)/ActivityEngineCore.o $(OUTDIR)/com_caller.o \
	$(OUTDIR)/ComCallerRemote.o $(OUTDIR)/corba_caller.o \
	$(OUTDIR)/corba_util.o $(OUTDIR)/ejb_caller.o \
	$(OUTDIR)/ejb_corba_srv.o $(OUTDIR)/engine_util.o \
	$(OUTDIR)/EngineCore.o $(OUTDIR)/EngineDebugUtils.o \
	$(OUTDIR)/FaultToleranceEngineCore.o $(OUTDIR)/FaultTolerantObject.o \
	$(OUTDIR)/IncomingMsg.o $(OUTDIR)/InstanceEngineCore.o \
	$(OUTDIR)/IRBrowser.o $(OUTDIR)/LDAPWrapper.o \
	$(OUTDIR)/ObjectAccessControl.o $(OUTDIR)/RoutingEngineCore.o \
	$(OUTDIR)/script.o $(OUTDIR)/SoapCaller.o $(OUTDIR)/SoapException.o \
	$(OUTDIR)/SoapPacket.o $(OUTDIR)/TaskDataElement.o \
	$(OUTDIR)/ThreadData.o $(OUTDIR)/ThreadManager.o \
	$(OUTDIR)/UtilityEngineCore.o $(OUTDIR)/ValidationEngineCore.o \
	$(OUTDIR)/Globals.o $(OUTDIR)/ProcessEngine.o \
	-L../../../../../../lib/konga -lkonga-dbmaintenance-d \
	-lkonga-dbutils-d -lkonga-filetransfer-d -lkonga-guidmappings-d \
	-lkonga-idb-d -lkonga-itemaccess-d -lkonga-log-d -lkonga-mime-d \
	-lkonga-msgdb-d -lkonga-networking-d -lkonga-operationengine-d \
	-lkonga-operationlog-d -lkonga-pdb-d -lkonga-pluginmanager-d \
	-lkonga-server-d -lkonga-serverversion-d -lkonga-sysinfo-d \
	-lkonga-trandb-d -lkonga-transformationengine-d -lkonga-utils-d \
	-lkonga-workflow-d -lboost_thread-$(BOOST_LIB_TAG)-d \
	-lboost_filesystem-$(BOOST_LIB_TAG)-d -lodbc 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Engine/Messenger/%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Engine/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeProcessEngine ../../../../../../bin/konga/Debug/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

