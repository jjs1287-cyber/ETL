# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-jdbcutils-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-javabackendconfiguration-d -lkonga-jdbcenginec-d \
	-lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/JdbcDbLookup.o $(OUTDIR)/JdbcEngineWrapper.o \
	$(OUTDIR)/ReadSource.o $(OUTDIR)/WriteTarget.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/JdbcDbLookup.o $(OUTDIR)/JdbcEngineWrapper.o \
	$(OUTDIR)/ReadSource.o $(OUTDIR)/WriteTarget.o \
	-L../../../../../../lib/konga -lkonga-crypto-d -lkonga-dbutils-d \
	-lkonga-guidmappings-d -lkonga-javabackendconfiguration-d \
	-lkonga-jdbcenginec-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-jdbcutils-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-jdbcutils.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto -lkonga-dbutils \
	-lkonga-guidmappings -lkonga-javabackendconfiguration \
	-lkonga-jdbcenginec -lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/JdbcDbLookup.o $(OUTDIR)/JdbcEngineWrapper.o \
	$(OUTDIR)/ReadSource.o $(OUTDIR)/WriteTarget.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/JdbcDbLookup.o $(OUTDIR)/JdbcEngineWrapper.o \
	$(OUTDIR)/ReadSource.o $(OUTDIR)/WriteTarget.o \
	-L../../../../../../lib/konga -lkonga-crypto -lkonga-dbutils \
	-lkonga-guidmappings -lkonga-javabackendconfiguration \
	-lkonga-jdbcenginec -lkonga-utils 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-jdbcutils.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
