# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-messaging-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-dataelement-d \
	-lkonga-dbutils-d -lkonga-guidmappings-d -lkonga-itemaccess-d \
	-lkonga-msgdb-d -lkonga-networking-d -lkonga-operationcontext-d \
	-lkonga-operationdataelements-d -lkonga-operationlog-d \
	-lkonga-server-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CheckOperationQueue.o $(OUTDIR)/JmsMessage.o \
	$(OUTDIR)/JmsMessageSender.o $(OUTDIR)/Message.o \
	$(OUTDIR)/MessageSender.o $(OUTDIR)/OperationMessageUtils.o \
	$(OUTDIR)/ProcessMessage.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CheckOperationQueue.o $(OUTDIR)/JmsMessage.o \
	$(OUTDIR)/JmsMessageSender.o $(OUTDIR)/Message.o \
	$(OUTDIR)/MessageSender.o $(OUTDIR)/OperationMessageUtils.o \
	$(OUTDIR)/ProcessMessage.o -L../../../../../../lib/konga/ \
	-lkonga-dataelement-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-msgdb-d -lkonga-networking-d \
	-lkonga-operationcontext-d -lkonga-operationdataelements-d \
	-lkonga-operationlog-d -lkonga-server-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-messaging-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-messaging.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-dataelement \
	-lkonga-dbutils -lkonga-guidmappings -lkonga-itemaccess \
	-lkonga-msgdb -lkonga-networking -lkonga-operationcontext \
	-lkonga-operationdataelements -lkonga-operationlog -lkonga-server \
	-lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CheckOperationQueue.o $(OUTDIR)/JmsMessage.o \
	$(OUTDIR)/JmsMessageSender.o $(OUTDIR)/Message.o \
	$(OUTDIR)/MessageSender.o $(OUTDIR)/OperationMessageUtils.o \
	$(OUTDIR)/ProcessMessage.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CheckOperationQueue.o $(OUTDIR)/JmsMessage.o \
	$(OUTDIR)/JmsMessageSender.o $(OUTDIR)/Message.o \
	$(OUTDIR)/MessageSender.o $(OUTDIR)/OperationMessageUtils.o \
	$(OUTDIR)/ProcessMessage.o -L../../../../../../lib/konga/ \
	-lkonga-dataelement -lkonga-dbutils -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-msgdb -lkonga-networking \
	-lkonga-operationcontext -lkonga-operationdataelements \
	-lkonga-operationlog -lkonga-server -lkonga-utils 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-messaging.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
