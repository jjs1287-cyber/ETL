			<Dependency Project="../../OperationDataElements/project/SlickEdit/OperationDataElements.vpj"/>
			<Dependency Project="../../OperationEngine/project/SlickEdit/OperationEngine.vpj"/>
			<Dependency Project="../../OperationLog/project/SlickEdit/OperationLog.vpj"/>
			<Dependency Project="../../PipelinePluginEntityManager/project/SlickEdit/PipelinePluginEntityManager.vpj"/>
			<Dependency Project="../../PipelinePluginExecutor/project/SlickEdit/PipelinePluginExecutor.vpj"/>
			<Dependency Project="../../PluginManager/project/SlickEdit/PluginManager.vpj"/>
			<Dependency Project="../../SchemaManager/project/SlickEdit/SchemaManager.vpj"/>
			<Dependency Project="../../Server/project/SlickEdit/Server.vpj"/>
			<Dependency Project="../../ServerVersion/project/SlickEdit/ServerVersion.vpj"/>
			<Dependency Project="../../TransformationEngine/project/SlickEdit/TransformationEngine.vpj"/>
			<Dependency Project="../../UiBackend/GuidMappings/project/SlickEdit/GuidMappings.vpj"/>
			<Dependency Project="../../UiBackend/UploadedFilesManager/project/SlickEdit/UploadedFilesManager.vpj"/>
			<Dependency Project="../../Workflow/DbWriter/project/SlickEdit/WfDbWriter.vpj"/>
			<Dependency Project="../../Workflow/Validation/project/SlickEdit/WorkflowValidation.vpj"/>
			<Dependency Project="../../Workflow/XmlReader/project/SlickEdit/WfXmlReader.vpj"/>
			<Dependency Project="../../Workflow/project/SlickEdit/Workflow.vpj"/>
			<Dependency Project="../../FileCleanup/project/SlickEdit/FileCleanup.vpj"/>
			<Dependency Project="../../DbRelations/project/SlickEdit/DbRelations.vpj"/>
			<Dependency Project="../../ETLForgeUtils/project/SlickEdit/ETLForgeUtils.vpj"/>
			<Dependency Project="../../JmsUtils/project/SlickEdit/JmsUtils.vpj"/>
			<Dependency Project="../../OperationObjects/project/SlickEdit/OperationObjects.vpj"/>
			<Dependency Project="../../ProjectBackup/project/SlickEdit/ProjectBackup.vpj"/>
			<Dependency Project="../../ItemProperties/project/SlickEdit/ItemProperties.vpj"/>
			<Dependency Project="../../TransformationLogging/project/SlickEdit/TransformationLogging.vpj"/>
			<Dependency Project="../../TransformationUtils/project/SlickEdit/TransformationUtils.vpj"/>
			<Dependency Project="../../Deployer/project/SlickEdit/Deployer.vpj"/>
			<Dependency Project="../../OperationPipeline/project/SlickEdit/OperationPipeline.vpj"/>
			<Dependency Project="../../SystemVariables/project/SlickEdit/SystemVariables.vpj"/>
			<Dependency Project="../../HttpEndpoint/project/SlickEdit/HttpEndpoint.vpj"/>
			<Dependency Project="../../ScheduleUtils/project/SlickEdit/ScheduleUtils.vpj"/>
			<Dependency Project="../../SchedulerProc/project/SlickEdit/SchedulerProc.vpj"/>
			<Dependency Project="../../Scheduler/project/SlickEdit/Scheduler.vpj"/>
			<Dependency Project="../../JavaBackend/JavaBackendConfiguration/project/SlickEdit/JavaBackendConfiguration.vpj"/>
			<Dependency Project="../../JdbcUtils/project/SlickEdit/JdbcUtils.vpj"/>
			<Dependency Project="../../JavaBackend/JdbcEngineC/project/SlickEdit/JdbcEngineC.vpj"/>
			<Dependency Project="../../OperationEngine/Process/project/SlickEdit/OperationEngineProc.vpj"/>
			<Dependency Project="../../OperationEngine/Process/project/SlickEdit/OperationEngineProc.vpj"/>
			<Dependency Project="../../ProcessEngine/project/SlickEdit/ProcessEngine.vpj"/>
			<Dependency Project="../../TransformationDataStore/project/SlickEdit/TransformationDataStore.vpj"/>
		</Dependencies>
		<Includes/>
		<Libs PreObjects="0">
			<Lib File="-L../../../../lib/konga/"/>
		</Libs>
	</Config>
