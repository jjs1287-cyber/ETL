# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-pdb-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-dbutils-d \
	-lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ActivityRuleTab.o $(OUTDIR)/ActivityTab.o \
	$(OUTDIR)/ArchiveCRPDBFinal.o $(OUTDIR)/ArgumentTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/CryptoTab.o \
	$(OUTDIR)/DocumentTab.o $(OUTDIR)/FunctionTab.o \
	$(OUTDIR)/GetLogGUIDProcID.o $(OUTDIR)/MultiServerSetupTab.o \
	$(OUTDIR)/ObjectPermissionsTab.o \
	$(OUTDIR)/OrganizationStructureTab.o $(OUTDIR)/ProcessTab.o \
	$(OUTDIR)/RouteTab.o $(OUTDIR)/RoutingRuleTab.o \
	$(OUTDIR)/TaskDataElementsTab.o $(OUTDIR)/TaskDisplayAttributes.o \
	$(OUTDIR)/TaskTab.o $(OUTDIR)/TransferTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ActivityRuleTab.o $(OUTDIR)/ActivityTab.o \
	$(OUTDIR)/ArchiveCRPDBFinal.o $(OUTDIR)/ArgumentTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/CryptoTab.o \
	$(OUTDIR)/DocumentTab.o $(OUTDIR)/FunctionTab.o \
	$(OUTDIR)/GetLogGUIDProcID.o $(OUTDIR)/MultiServerSetupTab.o \
	$(OUTDIR)/ObjectPermissionsTab.o \
	$(OUTDIR)/OrganizationStructureTab.o $(OUTDIR)/ProcessTab.o \
	$(OUTDIR)/RouteTab.o $(OUTDIR)/RoutingRuleTab.o \
	$(OUTDIR)/TaskDataElementsTab.o $(OUTDIR)/TaskDisplayAttributes.o \
	$(OUTDIR)/TaskTab.o $(OUTDIR)/TransferTab.o \
	-L../../../../../../../lib/konga -lkonga-dbutils-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-pdb-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-pdb.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-dbutils \
	-lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ActivityRuleTab.o $(OUTDIR)/ActivityTab.o \
	$(OUTDIR)/ArchiveCRPDBFinal.o $(OUTDIR)/ArgumentTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/CryptoTab.o \
	$(OUTDIR)/DocumentTab.o $(OUTDIR)/FunctionTab.o \
	$(OUTDIR)/GetLogGUIDProcID.o $(OUTDIR)/MultiServerSetupTab.o \
	$(OUTDIR)/ObjectPermissionsTab.o \
	$(OUTDIR)/OrganizationStructureTab.o $(OUTDIR)/ProcessTab.o \
	$(OUTDIR)/RouteTab.o $(OUTDIR)/RoutingRuleTab.o \
	$(OUTDIR)/TaskDataElementsTab.o $(OUTDIR)/TaskDisplayAttributes.o \
	$(OUTDIR)/TaskTab.o $(OUTDIR)/TransferTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ActivityRuleTab.o $(OUTDIR)/ActivityTab.o \
	$(OUTDIR)/ArchiveCRPDBFinal.o $(OUTDIR)/ArgumentTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/CryptoTab.o \
	$(OUTDIR)/DocumentTab.o $(OUTDIR)/FunctionTab.o \
	$(OUTDIR)/GetLogGUIDProcID.o $(OUTDIR)/MultiServerSetupTab.o \
	$(OUTDIR)/ObjectPermissionsTab.o \
	$(OUTDIR)/OrganizationStructureTab.o $(OUTDIR)/ProcessTab.o \
	$(OUTDIR)/RouteTab.o $(OUTDIR)/RoutingRuleTab.o \
	$(OUTDIR)/TaskDataElementsTab.o $(OUTDIR)/TaskDisplayAttributes.o \
	$(OUTDIR)/TaskTab.o $(OUTDIR)/TransferTab.o \
	-L../../../../../../../lib/konga -lkonga-dbutils -lkonga-utils 

COMPILE=g++ -c   -O0 -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-pdb.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
