<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/9.1/vpj.dtd">
<Project
	Version="9.1"
	VendorName="SlickEdit"
	WorkingDir="."
	BuildSystem="vsbuild">
	<Config
		Name="Debug"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile=""
		CompilerConfigName="Latest Version"
		Defines="">
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveCurrent"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ -c %xup %defd -g -fPIC -o "%bd%n%oe" %i "%f"'/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveCurrent"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -g -shared -fPIC -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%(VSLICKBIN1)vsbuild" "%w" "%r" -t build'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%(VSLICKBIN1)vsbuild" "%w" "%r" -t rebuild'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
			<Include Dir="../../../../.."/>
      <Include Dir="/usr/local/include"/>
		</Includes>
		<Libs PreObjects="0">
		</Libs>
	</Config>
	<Config
		Name="Release"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile=""
		CompilerConfigName="Latest Version"
		Defines="">
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveCurrent"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ -c %xup %defd -fPIC -o "%bd%n%oe" %i "%f"'/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveCurrent"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -shared -fPIC -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%(VSLICKBIN1)vsbuild" "%w" "%r" -t build'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%(VSLICKBIN1)vsbuild" "%w" "%r" -t rebuild'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
			<Include Dir="../../../../.."/>
      <Include Dir="/usr/local/include"/>
		</Includes>
		<Libs PreObjects="0">
		</Libs>
	</Config>
	<Files>
		<Folder
			Name="Source Files"
			Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl">
		</Folder>
		<Folder
			Name="Header Files"
			Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.inc;*.sh;*.cpy;*.if">
			<F N="../../DtlAddress.h"/>
			<F N="../../DtlArchiveCR_B2Bi_TPA.h"/>
			<F N="../../DtlArchiveCR_B2BI_TPA2.h"/>
			<F N="../../DtlArchiveCR_B2BI_TPA3.h"/>
			<F N="../../DtlArchiveCR_B2BI_TPAFinal.h"/>
			<F N="../../DtlBackEndFieldControl.h"/>
			<F N="../../DtlBackEndNode.h"/>
			<F N="../../DtlBackEndType.h"/>
			<F N="../../DtlBinding.h"/>
			<F N="../../DtlBindings.h"/>
			<F N="../../DtlCertificateInfo.h"/>
			<F N="../../DtlContact.h"/>
			<F N="../../DtlCRIDB_ActivityTab.h"/>
			<F N="../../DtlCRIDB_DataElementTab.h"/>
			<F N="../../DtlCRIDB_InstanceInfoTab.h"/>
			<F N="../../DtlCRIDB_ProcessTab.h"/>
			<F N="../../DtlCRIDB_RouteDataElementTab.h"/>
			<F N="../../DtlCRIDB_RouteTab.h"/>
			<F N="../../DtlCRIDB_StatusTab.h"/>
			<F N="../../DtlCRIDB_TemporaryFileTab.h"/>
			<F N="../../DtlCRPDB_MultiServerSetupTab.h"/>
			<F N="../../DtlCRTRANDB_BackendOperation.h"/>
			<F N="../../DtlCRTRANDB_Operations.h"/>
			<F N="../../DtlCRTRANDB_OPERATIONSTAB.h"/>
			<F N="../../DtlCRTRANDB_TRANSFORMATIONSTAB.h"/>
			<F N="../../DtlErrorCodes.h"/>
			<F N="../../DtlFieldValues.h"/>
			<F N="../../DtlFramework.h"/>
			<F N="../../DtlFwComponents.h"/>
			<F N="../../DtlGLFields.h"/>
			<F N="../../DtlKey_Values.h"/>
			<F N="../../DtlLog.h"/>
			<F N="../../DtlLOG_PIC.h"/>
			<F N="../../DtlLog_PIC_View.h"/>
			<F N="../../DtlLog_RN_View.h"/>
			<F N="../../DtlLogBaseView.h"/>
			<F N="../../DtlLogView.h"/>
			<F N="../../DtlMessage.h"/>
			<F N="../../DtlMessageProtocol.h"/>
			<F N="../../DtlPIC.h"/>
			<F N="../../DtlPIPType.h"/>
			<F N="../../DtlProcess.h"/>
			<F N="../../DtlProcess_Task.h"/>
			<F N="../../DtlProcessGroup.h"/>
			<F N="../../DtlProcessGroup_Process.h"/>
			<F N="../../DtlRN_TreeView1.h"/>
			<F N="../../DtlRole.h"/>
			<F N="../../DtlService.h"/>
			<F N="../../DtlStatus.h"/>
			<F N="../../DtlStatusControl.h"/>
			<F N="../../DtlStatusFieldControl.h"/>
			<F N="../../DtlTask.h"/>
			<F N="../../DtlTPA.h"/>
			<F N="../../DtlTPA_ProcessGroup.h"/>
			<F N="../../DtlTPAAttachments.h"/>
			<F N="../../DtlTPABackEnd.h"/>
			<F N="../../DtlTPAErrorMonitor.h"/>
			<F N="../../DtlTPARoles.h"/>
			<F N="../../DtlTPAServices.h"/>
			<F N="../../DtlTPP.h"/>
			<F N="../../DtlTPP_ALL.h"/>
		</Folder>
		<Folder
			Name="Resource Files"
			Filters="*.ico;*.cur;*.dlg"/>
		<Folder
			Name="Bitmaps"
			Filters="*.bmp"/>
		<Folder
			Name="Other Files"
			Filters=""/>
	</Files>
</Project>
