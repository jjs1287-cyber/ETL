# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-trandb-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-dbutils-d \
	-lkonga-dtldbutils-d -lkonga-dtltrandb-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/DBFieldsTab.o $(OUTDIR)/DBTablesTab.o \
	$(OUTDIR)/Document_DefinitionsTab.o $(OUTDIR)/DocumentsTab.o \
	$(OUTDIR)/FolderItemTab.o $(OUTDIR)/HistoryLogsView.o \
	$(OUTDIR)/interchangeprojectfolderstab.o \
	$(OUTDIR)/interchangeprojectoperationstab.o \
	$(OUTDIR)/JmsProvidersTab.o $(OUTDIR)/Key_Values.o \
	$(OUTDIR)/LogAuxTab.o $(OUTDIR)/LogTab.o $(OUTDIR)/MessagesTab.o \
	$(OUTDIR)/OperationLogsView.o $(OUTDIR)/OperationsTab.o \
	$(OUTDIR)/PipelinePluginInstanceTab.o \
	$(OUTDIR)/PipelinePluginPositionTab.o $(OUTDIR)/PluginsTab.o \
	$(OUTDIR)/ProjectOperationsView.o $(OUTDIR)/ScheduledOperationView.o \
	$(OUTDIR)/ScheduleTab.o $(OUTDIR)/ScriptsTab.o \
	$(OUTDIR)/SourceDtdView.o $(OUTDIR)/SourcesTab.o \
	$(OUTDIR)/SpInsertLogTab.o $(OUTDIR)/SpInsertOperationInstanceTab.o \
	$(OUTDIR)/SqlScriptTab.o $(OUTDIR)/TargetDtdView.o \
	$(OUTDIR)/TargetsTab.o $(OUTDIR)/Tran_RelationsTab.o \
	$(OUTDIR)/Trans_FilterTab.o \
	$(OUTDIR)/Transformation_DefinitionsTab.o \
	$(OUTDIR)/TransformationChainLinksTab.o \
	$(OUTDIR)/TransformationFunctionTab.o \
	$(OUTDIR)/TRANSFORMATIONSTAB_V.o $(OUTDIR)/UsersTab.o \
	$(OUTDIR)/Variable_TypesTab.o $(OUTDIR)/WebServicesTab.o \
	$(OUTDIR)/WebServiceView2.o $(OUTDIR)/WsdlTab.o $(OUTDIR)/XferHist.o \
	$(OUTDIR)/XferHistoryLogsView.o $(OUTDIR)/XmlDtdChildrenView.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/DBFieldsTab.o $(OUTDIR)/DBTablesTab.o \
	$(OUTDIR)/Document_DefinitionsTab.o $(OUTDIR)/DocumentsTab.o \
	$(OUTDIR)/FolderItemTab.o $(OUTDIR)/HistoryLogsView.o \
	$(OUTDIR)/interchangeprojectfolderstab.o \
	$(OUTDIR)/interchangeprojectoperationstab.o \
	$(OUTDIR)/JmsProvidersTab.o $(OUTDIR)/Key_Values.o \
	$(OUTDIR)/LogAuxTab.o $(OUTDIR)/LogTab.o $(OUTDIR)/MessagesTab.o \
	$(OUTDIR)/OperationLogsView.o $(OUTDIR)/OperationsTab.o \
	$(OUTDIR)/PipelinePluginInstanceTab.o \
	$(OUTDIR)/PipelinePluginPositionTab.o $(OUTDIR)/PluginsTab.o \
	$(OUTDIR)/ProjectOperationsView.o $(OUTDIR)/ScheduledOperationView.o \
	$(OUTDIR)/ScheduleTab.o $(OUTDIR)/ScriptsTab.o \
	$(OUTDIR)/SourceDtdView.o $(OUTDIR)/SourcesTab.o \
	$(OUTDIR)/SpInsertLogTab.o $(OUTDIR)/SpInsertOperationInstanceTab.o \
	$(OUTDIR)/SqlScriptTab.o $(OUTDIR)/TargetDtdView.o \
	$(OUTDIR)/TargetsTab.o $(OUTDIR)/Tran_RelationsTab.o \
	$(OUTDIR)/Trans_FilterTab.o \
	$(OUTDIR)/Transformation_DefinitionsTab.o \
	$(OUTDIR)/TransformationChainLinksTab.o \
	$(OUTDIR)/TransformationFunctionTab.o \
	$(OUTDIR)/TRANSFORMATIONSTAB_V.o $(OUTDIR)/UsersTab.o \
	$(OUTDIR)/Variable_TypesTab.o $(OUTDIR)/WebServicesTab.o \
	$(OUTDIR)/WebServiceView2.o $(OUTDIR)/WsdlTab.o $(OUTDIR)/XferHist.o \
	$(OUTDIR)/XferHistoryLogsView.o $(OUTDIR)/XmlDtdChildrenView.o \
	-L../../../../../../../lib/konga -lkonga-dbutils-d \
	-lkonga-dtldbutils-d -lkonga-dtltrandb-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-trandb-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

