# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-msgdb-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-dtlmsgdb-d \
	-lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArchiveAttachmentTab.o \
	$(OUTDIR)/ArchiveCRMSGDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o \
	$(OUTDIR)/ArchiveDistributionJobInstanceTab.o \
	$(OUTDIR)/ArchiveMsgTab.o $(OUTDIR)/ArchiveOutgoingMsgTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/DataElementTab.o \
	$(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/DistributionJobInstanceTab.o \
	$(OUTDIR)/DistributionJobTab.o $(OUTDIR)/DistributionTab.o \
	$(OUTDIR)/ErrorDataElementTab.o $(OUTDIR)/ErrorDataElementTextTab.o \
	$(OUTDIR)/ErrorMsgTab.o $(OUTDIR)/EventMsgTab.o \
	$(OUTDIR)/IncomingMsgTab.o $(OUTDIR)/OutgoingMsgTab.o \
	$(OUTDIR)/PermanentErrorMsgTab.o $(OUTDIR)/POPAccountsTab.o \
	$(OUTDIR)/RecommendationsTab.o $(OUTDIR)/SettingsTab.o \
	$(OUTDIR)/SpInsertIncomingMsgTab.o $(OUTDIR)/TransientErrorMsgTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArchiveAttachmentTab.o \
	$(OUTDIR)/ArchiveCRMSGDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o \
	$(OUTDIR)/ArchiveDistributionJobInstanceTab.o \
	$(OUTDIR)/ArchiveMsgTab.o $(OUTDIR)/ArchiveOutgoingMsgTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/DataElementTab.o \
	$(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/DistributionJobInstanceTab.o \
	$(OUTDIR)/DistributionJobTab.o $(OUTDIR)/DistributionTab.o \
	$(OUTDIR)/ErrorDataElementTab.o $(OUTDIR)/ErrorDataElementTextTab.o \
	$(OUTDIR)/ErrorMsgTab.o $(OUTDIR)/EventMsgTab.o \
	$(OUTDIR)/IncomingMsgTab.o $(OUTDIR)/OutgoingMsgTab.o \
	$(OUTDIR)/PermanentErrorMsgTab.o $(OUTDIR)/POPAccountsTab.o \
	$(OUTDIR)/RecommendationsTab.o $(OUTDIR)/SettingsTab.o \
	$(OUTDIR)/SpInsertIncomingMsgTab.o $(OUTDIR)/TransientErrorMsgTab.o \
	-L../../../../../../../lib/konga -lkonga-dtlmsgdb-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-msgdb-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-msgdb.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-dtlmsgdb \
	-lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArchiveAttachmentTab.o \
	$(OUTDIR)/ArchiveCRMSGDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o \
	$(OUTDIR)/ArchiveDistributionJobInstanceTab.o \
	$(OUTDIR)/ArchiveMsgTab.o $(OUTDIR)/ArchiveOutgoingMsgTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/DataElementTab.o \
	$(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/DistributionJobInstanceTab.o \
	$(OUTDIR)/DistributionJobTab.o $(OUTDIR)/DistributionTab.o \
	$(OUTDIR)/ErrorDataElementTab.o $(OUTDIR)/ErrorDataElementTextTab.o \
	$(OUTDIR)/ErrorMsgTab.o $(OUTDIR)/EventMsgTab.o \
	$(OUTDIR)/IncomingMsgTab.o $(OUTDIR)/OutgoingMsgTab.o \
	$(OUTDIR)/PermanentErrorMsgTab.o $(OUTDIR)/POPAccountsTab.o \
	$(OUTDIR)/RecommendationsTab.o $(OUTDIR)/SettingsTab.o \
	$(OUTDIR)/SpInsertIncomingMsgTab.o $(OUTDIR)/TransientErrorMsgTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArchiveAttachmentTab.o \
	$(OUTDIR)/ArchiveCRMSGDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o \
	$(OUTDIR)/ArchiveDistributionJobInstanceTab.o \
	$(OUTDIR)/ArchiveMsgTab.o $(OUTDIR)/ArchiveOutgoingMsgTab.o \
	$(OUTDIR)/AttachmentTab.o $(OUTDIR)/DataElementTab.o \
	$(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/DistributionJobInstanceTab.o \
	$(OUTDIR)/DistributionJobTab.o $(OUTDIR)/DistributionTab.o \
	$(OUTDIR)/ErrorDataElementTab.o $(OUTDIR)/ErrorDataElementTextTab.o \
	$(OUTDIR)/ErrorMsgTab.o $(OUTDIR)/EventMsgTab.o \
	$(OUTDIR)/IncomingMsgTab.o $(OUTDIR)/OutgoingMsgTab.o \
	$(OUTDIR)/PermanentErrorMsgTab.o $(OUTDIR)/POPAccountsTab.o \
	$(OUTDIR)/RecommendationsTab.o $(OUTDIR)/SettingsTab.o \
	$(OUTDIR)/SpInsertIncomingMsgTab.o $(OUTDIR)/TransientErrorMsgTab.o \
	-L../../../../../../../lib/konga -lkonga-dtlmsgdb -lkonga-utils 

COMPILE=g++ -c   -O0 -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-msgdb.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
