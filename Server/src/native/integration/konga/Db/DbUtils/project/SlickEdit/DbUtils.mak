# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-dbutils-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -L/usr/local/lib \
	-lkonga-dtldbutils-d -lkonga-utils-d -lodbc 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ConnectionString.o $(OUTDIR)/DbConnection.o \
	$(OUTDIR)/DbConnectionHolder.o $(OUTDIR)/DbProcedureColumn.o \
	$(OUTDIR)/DbUtils.o $(OUTDIR)/DynamicDbRecordSet.o \
	$(OUTDIR)/OdbcBoundValue.o $(OUTDIR)/OdbcConnectionHolder.o \
	$(OUTDIR)/OdbcDbLookup.o $(OUTDIR)/Sql_ODBC_Ext.o \
	$(OUTDIR)/StoredProcedureCaller.o $(OUTDIR)/TableColumnsOdbc.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ConnectionString.o $(OUTDIR)/DbConnection.o \
	$(OUTDIR)/DbConnectionHolder.o $(OUTDIR)/DbProcedureColumn.o \
	$(OUTDIR)/DbUtils.o $(OUTDIR)/DynamicDbRecordSet.o \
	$(OUTDIR)/OdbcBoundValue.o $(OUTDIR)/OdbcConnectionHolder.o \
	$(OUTDIR)/OdbcDbLookup.o $(OUTDIR)/Sql_ODBC_Ext.o \
	$(OUTDIR)/StoredProcedureCaller.o $(OUTDIR)/TableColumnsOdbc.o \
	-L../../../../../../../lib/konga/ -L/usr/local/lib \
	-lkonga-dtldbutils-d -lkonga-utils-d -lodbc 

COMPILE=g++ -c  "-D_DEBUG" "-DHAVE_LONG_LONG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-dbutils-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-dbutils.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -L/usr/local/lib \
	-lkonga-dtldbutils -lkonga-utils -lodbc 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ConnectionString.o $(OUTDIR)/DbConnection.o \
	$(OUTDIR)/DbConnectionHolder.o $(OUTDIR)/DbProcedureColumn.o \
	$(OUTDIR)/DbUtils.o $(OUTDIR)/DynamicDbRecordSet.o \
	$(OUTDIR)/OdbcBoundValue.o $(OUTDIR)/OdbcConnectionHolder.o \
	$(OUTDIR)/OdbcDbLookup.o $(OUTDIR)/Sql_ODBC_Ext.o \
	$(OUTDIR)/StoredProcedureCaller.o $(OUTDIR)/TableColumnsOdbc.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ConnectionString.o $(OUTDIR)/DbConnection.o \
	$(OUTDIR)/DbConnectionHolder.o $(OUTDIR)/DbProcedureColumn.o \
	$(OUTDIR)/DbUtils.o $(OUTDIR)/DynamicDbRecordSet.o \
	$(OUTDIR)/OdbcBoundValue.o $(OUTDIR)/OdbcConnectionHolder.o \
	$(OUTDIR)/OdbcDbLookup.o $(OUTDIR)/Sql_ODBC_Ext.o \
	$(OUTDIR)/StoredProcedureCaller.o $(OUTDIR)/TableColumnsOdbc.o \
	-L../../../../../../../lib/konga/ -L/usr/local/lib \
	-lkonga-dtldbutils -lkonga-utils -lodbc 

COMPILE=g++ -c  "-DHAVE_LONG_LONG" -O2 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O2 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-dbutils.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
