# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----

# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/Db
CFG_INC=
CFG_LIB=
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/Db.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/Db.o 

COMPILE=g++ -c    -g -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -g -o "$(OUTFILE)" $(OBJ) $(CFG_LIB)

# Pattern rules
$(OUTDIR)/%.o : %.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR) deps $(OBJ)
	$(LINK)

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Build dependencies
deps:
	@(cd ../../DbMaintenance/project/SlickEdit/;$(MAKE) -f DbMaintenance.mak CFG=$(CFG))
	@(cd ../../DbUtils/project/SlickEdit/;$(MAKE) -f DbUtils.mak CFG=$(CFG))
	@(cd ../../DtlDbUtils/project/SlickEdit/;$(MAKE) -f DtlDbUtils.mak CFG=$(CFG))
	@(cd ../../DtlIDb/project/SlickEdit/;$(MAKE) -f DtlIDb.mak CFG=$(CFG))
	@(cd ../../DtlMsgDb/project/SlickEdit/;$(MAKE) -f DtlMsgDb.mak CFG=$(CFG))
	@(cd ../../DtlPDb/project/SlickEdit/;$(MAKE) -f DtlPDb.mak CFG=$(CFG))
	@(cd ../../DtlTranDb/project/SlickEdit/;$(MAKE) -f DtlTranDb.mak CFG=$(CFG))
	@(cd ../../IDb/project/SlickEdit/;$(MAKE) -f IDb.mak CFG=$(CFG))
	@(cd ../../MsgDb/project/SlickEdit/;$(MAKE) -f MsgDb.mak CFG=$(CFG))
	@(cd ../../PDb/project/SlickEdit/;$(MAKE) -f PDb.mak CFG=$(CFG))
	@(cd ../../SchemaInfo/project/SlickEdit/;$(MAKE) -f SchemaInfo.mak CFG=$(CFG))
	@(cd ../../TranDb/project/SlickEdit/;$(MAKE) -f TranDb.mak CFG=$(CFG))
	@(cd ../../TranDbUtils/project/SlickEdit/;$(MAKE) -f TranDbUtils.mak CFG=$(CFG))

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
	@(cd ../../DbMaintenance/project/SlickEdit/;$(MAKE) -f DbMaintenance.mak cleanall CFG=$(CFG))
	@(cd ../../DbUtils/project/SlickEdit/;$(MAKE) -f DbUtils.mak cleanall CFG=$(CFG))
	@(cd ../../DtlDbUtils/project/SlickEdit/;$(MAKE) -f DtlDbUtils.mak cleanall CFG=$(CFG))
	@(cd ../../DtlIDb/project/SlickEdit/;$(MAKE) -f DtlIDb.mak cleanall CFG=$(CFG))
	@(cd ../../DtlMsgDb/project/SlickEdit/;$(MAKE) -f DtlMsgDb.mak cleanall CFG=$(CFG))
	@(cd ../../DtlPDb/project/SlickEdit/;$(MAKE) -f DtlPDb.mak cleanall CFG=$(CFG))
	@(cd ../../DtlTranDb/project/SlickEdit/;$(MAKE) -f DtlTranDb.mak cleanall CFG=$(CFG))
	@(cd ../../IDb/project/SlickEdit/;$(MAKE) -f IDb.mak cleanall CFG=$(CFG))
	@(cd ../../MsgDb/project/SlickEdit/;$(MAKE) -f MsgDb.mak cleanall CFG=$(CFG))
	@(cd ../../PDb/project/SlickEdit/;$(MAKE) -f PDb.mak cleanall CFG=$(CFG))
	@(cd ../../SchemaInfo/project/SlickEdit/;$(MAKE) -f SchemaInfo.mak cleanall CFG=$(CFG))
	@(cd ../../TranDb/project/SlickEdit/;$(MAKE) -f TranDb.mak cleanall CFG=$(CFG))
	@(cd ../../TranDbUtils/project/SlickEdit/;$(MAKE) -f TranDbUtils.mak cleanall CFG=$(CFG))
endif

