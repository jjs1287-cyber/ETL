# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-dtlidb-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -lkonga-dtldbutils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/DtlSpInsertProcessTab.o \
	$(OUTDIR)/DtlSpInsertRouteTab.o $(OUTDIR)/DtlSpInsertSessionIdTab.o \
	$(OUTDIR)/DtlSpInsertTaskTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/DtlSpInsertProcessTab.o \
	$(OUTDIR)/DtlSpInsertRouteTab.o $(OUTDIR)/DtlSpInsertSessionIdTab.o \
	$(OUTDIR)/DtlSpInsertTaskTab.o -L../../../../../../../lib/konga/ \
	-lkonga-dtldbutils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-dtlidb-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-dtlidb.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -lkonga-dtldbutils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/DtlSpInsertProcessTab.o \
	$(OUTDIR)/DtlSpInsertRouteTab.o $(OUTDIR)/DtlSpInsertSessionIdTab.o \
	$(OUTDIR)/DtlSpInsertTaskTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/DtlSpInsertProcessTab.o \
	$(OUTDIR)/DtlSpInsertRouteTab.o $(OUTDIR)/DtlSpInsertSessionIdTab.o \
	$(OUTDIR)/DtlSpInsertTaskTab.o -L../../../../../../../lib/konga/ \
	-lkonga-dtldbutils 

COMPILE=g++ -c   -O2 -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O2 -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-dtlidb.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
