# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-idb-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -lkonga-dbutils-d \
	-lkonga-dtldbutils-d -lkonga-dtlidb-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ActivityTab.o $(OUTDIR)/ArchiveActivityTab.o \
	$(OUTDIR)/ArchiveCRIDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o $(OUTDIR)/ArchiveProcessTab.o \
	$(OUTDIR)/ArchiveRouteTab.o $(OUTDIR)/ArchiveTaskTab.o \
	$(OUTDIR)/DataElementTab.o $(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/InstanceInfoTab.o $(OUTDIR)/OperationDataElementTab.o \
	$(OUTDIR)/ProcessTab.o $(OUTDIR)/RouteDataElementTab.o \
	$(OUTDIR)/RouteDataElementTextTab.o $(OUTDIR)/RouteTab.o \
	$(OUTDIR)/SpInsertProcessTab.o $(OUTDIR)/SpInsertRouteTab.o \
	$(OUTDIR)/SpInsertSessionIdTab.o $(OUTDIR)/SpInsertTaskTab.o \
	$(OUTDIR)/StatusTab.o $(OUTDIR)/TaskTab.o \
	$(OUTDIR)/TemporaryFileTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ActivityTab.o $(OUTDIR)/ArchiveActivityTab.o \
	$(OUTDIR)/ArchiveCRIDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o $(OUTDIR)/ArchiveProcessTab.o \
	$(OUTDIR)/ArchiveRouteTab.o $(OUTDIR)/ArchiveTaskTab.o \
	$(OUTDIR)/DataElementTab.o $(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/InstanceInfoTab.o $(OUTDIR)/OperationDataElementTab.o \
	$(OUTDIR)/ProcessTab.o $(OUTDIR)/RouteDataElementTab.o \
	$(OUTDIR)/RouteDataElementTextTab.o $(OUTDIR)/RouteTab.o \
	$(OUTDIR)/SpInsertProcessTab.o $(OUTDIR)/SpInsertRouteTab.o \
	$(OUTDIR)/SpInsertSessionIdTab.o $(OUTDIR)/SpInsertTaskTab.o \
	$(OUTDIR)/StatusTab.o $(OUTDIR)/TaskTab.o \
	$(OUTDIR)/TemporaryFileTab.o -L../../../../../../../lib/konga/ \
	-lkonga-dbutils-d -lkonga-dtldbutils-d -lkonga-dtlidb-d \
	-lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-idb-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-idb.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga/ -lkonga-dbutils \
	-lkonga-dtldbutils -lkonga-dtlidb -lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ActivityTab.o $(OUTDIR)/ArchiveActivityTab.o \
	$(OUTDIR)/ArchiveCRIDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o $(OUTDIR)/ArchiveProcessTab.o \
	$(OUTDIR)/ArchiveRouteTab.o $(OUTDIR)/ArchiveTaskTab.o \
	$(OUTDIR)/DataElementTab.o $(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/InstanceInfoTab.o $(OUTDIR)/OperationDataElementTab.o \
	$(OUTDIR)/ProcessTab.o $(OUTDIR)/RouteDataElementTab.o \
	$(OUTDIR)/RouteDataElementTextTab.o $(OUTDIR)/RouteTab.o \
	$(OUTDIR)/SpInsertProcessTab.o $(OUTDIR)/SpInsertRouteTab.o \
	$(OUTDIR)/SpInsertSessionIdTab.o $(OUTDIR)/SpInsertTaskTab.o \
	$(OUTDIR)/StatusTab.o $(OUTDIR)/TaskTab.o \
	$(OUTDIR)/TemporaryFileTab.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ActivityTab.o $(OUTDIR)/ArchiveActivityTab.o \
	$(OUTDIR)/ArchiveCRIDBFinal.o $(OUTDIR)/ArchiveDataElementTab.o \
	$(OUTDIR)/ArchiveDataElementTextTab.o $(OUTDIR)/ArchiveProcessTab.o \
	$(OUTDIR)/ArchiveRouteTab.o $(OUTDIR)/ArchiveTaskTab.o \
	$(OUTDIR)/DataElementTab.o $(OUTDIR)/DataElementTextTab.o \
	$(OUTDIR)/InstanceInfoTab.o $(OUTDIR)/OperationDataElementTab.o \
	$(OUTDIR)/ProcessTab.o $(OUTDIR)/RouteDataElementTab.o \
	$(OUTDIR)/RouteDataElementTextTab.o $(OUTDIR)/RouteTab.o \
	$(OUTDIR)/SpInsertProcessTab.o $(OUTDIR)/SpInsertRouteTab.o \
	$(OUTDIR)/SpInsertSessionIdTab.o $(OUTDIR)/SpInsertTaskTab.o \
	$(OUTDIR)/StatusTab.o $(OUTDIR)/TaskTab.o \
	$(OUTDIR)/TemporaryFileTab.o -L../../../../../../../lib/konga/ \
	-lkonga-dbutils -lkonga-dtldbutils -lkonga-dtlidb -lkonga-utils 

COMPILE=g++ -c   -O0 -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -shared -fPIC -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-idb.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
