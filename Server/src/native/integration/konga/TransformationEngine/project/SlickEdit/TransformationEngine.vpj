			<Lib File="-lkonga-ldap-d"/>
			<Lib File="-lkonga-log-d"/>
			<Lib File="-lkonga-messaging-d"/>
			<Lib File="-lkonga-mime-d"/>
			<Lib File="-lkonga-networking-d"/>
			<Lib File="-lkonga-operationcontext-d"/>
			<Lib File="-lkonga-operationobjects-d"/>
			<Lib File="-lkonga-pipelinepluginexecutor-d"/>
			<Lib File="-lkonga-pluginmanager-d"/>
