			<Lib File="-lboost_regex-$(BOOST_LIB_TAG)-d"/>
			<Lib File="-lboost_thread-$(BOOST_LIB_TAG)-d"/>
		</Libs>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-transformationengine-d.so ../../../../../../lib/konga/"/>
		</PostBuildCommands>
	</Config>
