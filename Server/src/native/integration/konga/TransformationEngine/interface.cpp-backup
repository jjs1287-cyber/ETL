//[id(5), helpstring("method WriteTree")] HRESULT WriteTree([in] BSTR inputFileName, [in] BSTR rootName, [in] BSTR outputFileName);
JNIEXPORT void JNICALL Java_CDTDParser_WriteTree
  (JNIEnv *env, jobject obj, jstring jsInputFileName, jstring jsRootName, jstring jsOutputFileName)
{
	const char* sInputFileName = env->GetStringUTFChars(jsInputFileName, 0);
	const char* sRootName = env->GetStringUTFChars(jsRootName, 0);
	const char* sOutputFileName = env->GetStringUTFChars(jsOutputFileName, 0);
	
	CDTDParser cdtd_parser;
	try {
		cdtd_parser.WriteTree(sInputFileName, sRootName, sOutputFileName);
		env->ReleaseStringUTFChars(jsInputFileName, sInputFileName);
		env->ReleaseStringUTFChars(jsRootName, sRootName);
		env->ReleaseStringUTFChars(jsOutputFileName, sOutputFileName);
	}
	catch(...){
		env->ReleaseStringUTFChars(jsInputFileName, sInputFileName);
		env->ReleaseStringUTFChars(jsRootName, sRootName);
		env->ReleaseStringUTFChars(jsOutputFileName, sOutputFileName);
		jclass ec=env->FindClass("java/lang/Exception");
		if(ec!=NULL)
			env->ThrowNew(ec, cdtd_parser.get_LastError().c_str());
	}
}

//[id(6), helpstring("method CreateXSDFromWSDLForBothIO")] HRESULT CreateXSDFromWSDLForBothIO([in] BSTR bstrWDSLFileName, [in] BSTR bstrBinding, [in] BSTR bstrOperationName, [in] BSTR bstrSoapOperationStyle, [in] BSTR bstrSoapBodyUse, [in] BSTR bstrInputXSDFileName, [in] BSTR bstrOutputXSDFileName);
JNIEXPORT void JNICALL Java_CDTDParser_CreateXSDFromWSDLForBothIO
  (JNIEnv *env, jobject obj, jstring jsWsdlFileName, jstring jsBinding, jstring jsOperationName, jstring jsSoapOperationStyle, jstring jsSoapBodyUse, jstring JSInputXSDFileName, jstring jsOuputXSDFileName)
{
	const char* sWsdlFileName = env->GetStringUTFChars(jsWsdlFileName, 0);
	const char* sBinding = env->GetStringUTFChars(jsBinding, 0);
	const char* sOperationName = env->GetStringUTFChars(jsOperationName, 0);
	const char* sSoapOperationStyle = env->GetStringUTFChars(jsSoapOperationStyle, 0);
	const char* sSoapBodyUse = env->GetStringUTFChars(jsSoapBodyUse, 0);
	const char* SInputXSDFileName = env->GetStringUTFChars(JSInputXSDFileName, 0);
	const char* sOuputXSDFileName = env->GetStringUTFChars(jsOuputXSDFileName, 0);
	CDTDParser cdtd_parser;
	try {
		cdtd_parser.CreateXSDFromWSDLForBothIO(sWsdlFileName, sBinding, sOperationName, sSoapOperationStyle, sSoapBodyUse, SInputXSDFileName, sOuputXSDFileName);
		env->ReleaseStringUTFChars(jsWsdlFileName, sWsdlFileName);
		env->ReleaseStringUTFChars(jsBinding, sBinding);
		env->ReleaseStringUTFChars(jsOperationName, sOperationName);
		env->ReleaseStringUTFChars(jsSoapOperationStyle, sSoapOperationStyle);
		env->ReleaseStringUTFChars(jsSoapBodyUse, sSoapBodyUse);
		env->ReleaseStringUTFChars(JSInputXSDFileName, SInputXSDFileName);
		env->ReleaseStringUTFChars(jsOuputXSDFileName, sOuputXSDFileName);
	}
	catch(...){
		env->ReleaseStringUTFChars(jsWsdlFileName, sWsdlFileName);
		env->ReleaseStringUTFChars(jsBinding, sBinding);
		env->ReleaseStringUTFChars(jsOperationName, sOperationName);
		env->ReleaseStringUTFChars(jsSoapOperationStyle, sSoapOperationStyle);
		env->ReleaseStringUTFChars(jsSoapBodyUse, sSoapBodyUse);
		env->ReleaseStringUTFChars(JSInputXSDFileName, SInputXSDFileName);
		env->ReleaseStringUTFChars(jsOuputXSDFileName, sOuputXSDFileName);
		jclass ec=env->FindClass("java/lang/Exception");
		if(ec!=NULL)
			env->ThrowNew(ec, cdtd_parser.get_LastError().c_str());
	}
}
//[id(7), helpstring("method GetRootSelectionList")] HRESULT GetRootSelectionList([in] BSTR bstrDtdFileName, [in] BSTR bstrOutputFileName, [in] BSTR bstrOutputFileName2);
JNIEXPORT void JNICALL Java_CDTDParser_GetRootSelectionList
  (JNIEnv *env, jobject obj, jstring jsDtdFileName, jstring jsOutputFileName, jstring jsOutputFileName2)
{
	const char* sDtdFileName = env->GetStringUTFChars(jsDtdFileName, 0);
	const char* sOutputFileName = env->GetStringUTFChars(jsOutputFileName, 0);
	const char* sOutputFileName2 = env->GetStringUTFChars(jsOutputFileName2, 0);
	CDTDParser cdtd_parser;
	try {
		cdtd_parser.GetRootSelectionList(sDtdFileName, sOutputFileName, sOutputFileName2);
		env->ReleaseStringUTFChars(jsDtdFileName, sDtdFileName);
		env->ReleaseStringUTFChars(jsOutputFileName, sOutputFileName);
		env->ReleaseStringUTFChars(jsOutputFileName2, sOutputFileName2);
	}
	catch(...){
		env->ReleaseStringUTFChars(jsDtdFileName, sDtdFileName);
		env->ReleaseStringUTFChars(jsOutputFileName, sOutputFileName);
		env->ReleaseStringUTFChars(jsOutputFileName2, sOutputFileName2);
		jclass ec=env->FindClass("java/lang/Exception");
		if(ec!=NULL)
			env->ThrowNew(ec, cdtd_parser.get_LastError().c_str());
	}
}
//[id(8), helpstring("method GetSystemRootName")] HRESULT GetSystemRootName([in] BSTR bstrSampleXmlFileName, [out, retval] BSTR* pbstrName);
JNIEXPORT jstring JNICALL Java_CDTDParser_GetSystemRootName
  (JNIEnv *env, jobject obj, jstring jsSampleXmlFileName)
{
	const char* sSampleXmlFileName = env->GetStringUTFChars(jsSampleXmlFileName, 0);
	CDTDParser cdtd_parser;
	try {
		std::string sSystemRootName=cdtd_parser.GetSystemRootName(sSampleXmlFileName);
		env->ReleaseStringUTFChars(jsSampleXmlFileName, sSampleXmlFileName);
		return env->NewStringUTF(sSystemRootName.c_str());
	}
	catch(...){
		env->ReleaseStringUTFChars(jsSampleXmlFileName, sSampleXmlFileName);
		jclass ec=env->FindClass("java/lang/Exception");
		if(ec!=NULL)
			env->ThrowNew(ec, cdtd_parser.get_LastError().c_str());
		else
			return NULL;
	}
}

