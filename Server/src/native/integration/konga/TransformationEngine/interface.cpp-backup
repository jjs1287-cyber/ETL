#include <vector>

#include "CDTDParser.h"
#include "TreeMapper.h"
#include "DETransform.h"

#include <konga/Utils/StringUtils.h>

namespace konga {

	struct js_pair {
		const char *s;
		jstring &js;
		js_pair(const char *s0, jstring &js0) : s(s0), js(js0){}
	};

	class JNIToolkit
	{
		std::vector<js_pair*> v;
		JNIEnv *env;
		jobject &obj;

	public:
		JNIToolkit(JNIEnv *env0, jobject &obj0) : env(env0), obj(obj0) {}
		
		~JNIToolkit(){
			for(std::vector<js_pair*>::iterator it=v.begin();it!=v.end();it++){
				js_pair*pair=*it;
				env->ReleaseStringUTFChars(pair->js, pair->s);
				delete pair;
			}
		}

		const char* getUTFChars(jstring &js)
		{
			const char*s=env->GetStringUTFChars(js, 0);
			v.push_back(new js_pair(s,js));
			return s;
		}

		void setString(const std::string& sName, const std::string& sValue)
		{
			std::string sMethodName=std::string("set")+sName;
			jclass cls=env->GetObjectClass(obj);
			jmethodID mid=env->GetMethodID(cls, sMethodName.c_str(), "(Ljava/lang/String;)V");
			jstring jsValue=env->NewStringUTF(sValue.c_str());
			env->CallVoidMethod(obj, mid, jsValue);
		}

		void setInteger(const std::string& sName, int i)
		{
			std::string sMethodName=std::string("set")+sName;
			jclass cls=env->GetObjectClass(obj);
			jmethodID mid=env->GetMethodID(cls, sMethodName.c_str(), "(Ljava/lang/Integer;)V");
			env->CallVoidMethod(obj, mid, i);
		}

		void throwException(const std::string& sMessage, const char* cls_name="java/lang/Exception")
		{
			jclass ec=env->FindClass(cls_name);
			if(ec!=NULL)env->ThrowNew(ec,sMessage.c_str());
		}
	};
}

using namespace std;

//	interface IDTDParser : IDispatch

//[id(1), helpstring("method CreateBrowserTree")] HRESULT CreateBrowserTree([in] BSTR inputFileName, [in]BSTR rootName, [in]BSTR javaFileName, [in]BSTR title, [in]BSTR Click);
JNIEXPORT void JNICALL Java_CDTDParser_CreateBrowserTree
(JNIEnv *env, jobject obj, jstring jsInputFileName, jstring jsRootName, jstring jsJavaFileName, jstring jsTitle, jstring jsClick)
{
	konga::JNIToolkit kit(env, obj);
	
	const char *sInputFileName = kit.getUTFChars(jsInputFileName);
	const char *sRootName = kit.getUTFChars(jsRootName);
	const char *sJavaFileName = kit.getUTFChars(jsJavaFileName);
	const char *sTitle = kit.getUTFChars(jsTitle);
	const char *sClick = kit.getUTFChars(jsClick);
	
	CDTDParser cdtd_parser;
	try {
		cdtd_parser.CreateBrowserTree(sInputFileName, sRootName, sJavaFileName, sTitle, sClick);
		kit.setString("ExtraDtdFiles",cdtd_parser.get_extraDtdFiles());
	}
	catch(...){
		kit.throwException(cdtd_parser.get_LastError());
	}
	
}
