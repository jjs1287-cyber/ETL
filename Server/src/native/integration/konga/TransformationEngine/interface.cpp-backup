		env->ReleaseStringUTFChars(jsRequestJtrFileName, sRequestJtrFileName);
		env->ReleaseStringUTFChars(jsResponseJtrFileName, sResponseJtrFileName);
		jclass ec=env->FindClass("java/lang/Exception");
		if(ec!=NULL)
			env->ThrowNew(ec, cdtd_parser.get_LastError().c_str());
	}
}
