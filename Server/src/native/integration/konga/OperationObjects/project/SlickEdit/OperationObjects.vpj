<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/10.0/vpj.dtd">
<Project
	Version="10.0"
	VendorName="SlickEdit"
	WorkingDir="."
	BuildSystem="automakefile"
	BuildMakeFile="%rp%rn.mak">
	<Config
		Name="Debug"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-operationobjects-d.so"
		CompilerConfigName="Latest Version"
		Defines='"/D_DEBUG"'>
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O0 -g -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O0 -g -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-operationobjects-d.so ../../../../../../lib/konga/"/>
		</PostBuildCommands>
		<Includes/>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../lib/konga"/>
			<Lib File="-lkonga-bulkloadenginec-d"/>
			<Lib File="-lkonga-crypto-d"/>
			<Lib File="-lkonga-dataelement-d"/>
			<Lib File="-lkonga-dbutils-d"/>
			<Lib File="-lkonga-filetransfer-d"/>
			<Lib File="-lkonga-itemaccess-d"/>
			<Lib File="-lkonga-jmsutils-d"/>
			<Lib File="-lkonga-ldap-d"/>
			<Lib File="-lkonga-log-d"/>
			<Lib File="-lkonga-mailclient-d"/>
			<Lib File="-lkonga-networking-d"/>
			<Lib File="-lkonga-operationcontext-d"/>
			<Lib File="-lkonga-pipelinepluginexecutor-d"/>
			<Lib File="-lkonga-pluginmanager-d"/>
			<Lib File="-lkonga-schemamanager-d"/>
			<Lib File="-lkonga-server-d"/>
			<Lib File="-lkonga-systemvariables-d"/>
			<Lib File="-lkonga-trandb-d"/>
			<Lib File="-lkonga-utils-d"/>
			<Lib File="-lboost_regex-$(BOOST_LIB_TAG)-d"/>
			<Lib File="-lboost_date_time-$(BOOST_LIB_TAG)-d"/>
		</Libs>
	</Config>
	<Config
		Name="Release"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-operationobjects.so"
		CompilerConfigName="Latest Version"
		Defines="">
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O3 -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				ShowOnMenu="Never"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O3 -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-operationobjects.so ../../../../../../lib/konga/"/>
		</PostBuildCommands>
		<Includes/>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../lib/konga"/>
			<Lib File="-lkonga-bulkloadenginec"/>
			<Lib File="-lkonga-crypto"/>
			<Lib File="-lkonga-dataelement"/>
			<Lib File="-lkonga-dbutils"/>
			<Lib File="-lkonga-filetransfer"/>
			<Lib File="-lkonga-itemaccess"/>
			<Lib File="-lkonga-jmsutils"/>
			<Lib File="-lkonga-ldap"/>
			<Lib File="-lkonga-log"/>
			<Lib File="-lkonga-mailclient"/>
			<Lib File="-lkonga-networking"/>
			<Lib File="-lkonga-operationcontext"/>
			<Lib File="-lkonga-pipelinepluginexecutor"/>
			<Lib File="-lkonga-pluginmanager"/>
			<Lib File="-lkonga-schemamanager"/>
			<Lib File="-lkonga-server"/>
			<Lib File="-lkonga-systemvariables"/>
			<Lib File="-lkonga-trandb"/>
			<Lib File="-lkonga-utils"/>
			<Lib File="-lboost_regex-$(BOOST_LIB_TAG)"/>
			<Lib File="-lboost_date_time-$(BOOST_LIB_TAG)"/>
		</Libs>
	</Config>
	<Files>
		<Folder
			Name="Source Files"
			Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl">
			<F N="../../ArchiveOperation.cpp"/>
			<F N="../../DatabaseLocation.cpp"/>
			<F N="../../DataLocation.cpp"/>
			<F N="../../EmailMessage.cpp"/>
			<F N="../../EmailMessageSender.cpp"/>
			<F N="../../FileShareLocation.cpp"/>
