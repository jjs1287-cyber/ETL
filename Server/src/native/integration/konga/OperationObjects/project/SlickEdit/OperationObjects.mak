# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-operationobjects-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-bulkloadenginec-d \
	-lkonga-crypto-d -lkonga-dataelement-d -lkonga-dbutils-d \
	-lkonga-filetransfer-d -lkonga-itemaccess-d -lkonga-jmsutils-d \
	-lkonga-ldap-d -lkonga-log-d -lkonga-mailclient-d \
	-lkonga-networking-d -lkonga-operationcontext-d \
	-lkonga-pipelinepluginexecutor-d -lkonga-pluginmanager-d \
	-lkonga-schemamanager-d -lkonga-server-d -lkonga-systemvariables-d \
	-lkonga-trandb-d -lkonga-utils-d -lboost_regex-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArchiveOperation.o $(OUTDIR)/DatabaseLocation.o \
	$(OUTDIR)/DataLocation.o $(OUTDIR)/EmailMessage.o \
	$(OUTDIR)/EmailMessageSender.o $(OUTDIR)/FileShareLocation.o \
	$(OUTDIR)/FileShareSource.o $(OUTDIR)/FileShareTarget.o \
	$(OUTDIR)/FileTypeSourceLocation.o \
	$(OUTDIR)/FileTypeTargetLocation.o $(OUTDIR)/FtpLocation.o \
	$(OUTDIR)/FtpSource.o $(OUTDIR)/FtpTarget.o $(OUTDIR)/HttpLocation.o \
	$(OUTDIR)/HttpSource.o $(OUTDIR)/HttpTarget.o \
	$(OUTDIR)/JmsLocation.o $(OUTDIR)/JmsSource.o \
	$(OUTDIR)/JmsSourceCreator.o $(OUTDIR)/JmsTarget.o \
	$(OUTDIR)/LdapLocation.o $(OUTDIR)/LocationCreatorDb.o \
	$(OUTDIR)/NoSource.o $(OUTDIR)/Operation.o \
	$(OUTDIR)/OperationEngineContext.o \
	$(OUTDIR)/OperationHistoryWriter.o \
	$(OUTDIR)/OperationObjectCreatorDb.o \
	$(OUTDIR)/OperationObjectCreatorKeyValues.o \
	$(OUTDIR)/OperationSummaryWriter.o \
	$(OUTDIR)/OverrideFileTypeSourceLocation.o \
	$(OUTDIR)/PreviousTargetAsSource.o $(OUTDIR)/ProcessedFiles.o \
	$(OUTDIR)/RenameFile.o $(OUTDIR)/SalesforceBulkLoadOperation.o \
	$(OUTDIR)/SourceDataLocation.o \
	$(OUTDIR)/SourceFromHostedWebServiceCall.o \
	$(OUTDIR)/SourceTargetPipelinePluginExecution.o \
	$(OUTDIR)/SourceXmlDataStructure.o $(OUTDIR)/TargetDataLocation.o \
	$(OUTDIR)/TargetXmlDataStructure.o \
	$(OUTDIR)/TemporaryStorageLocation.o \
	$(OUTDIR)/TemporaryStorageSource.o \
	$(OUTDIR)/TemporaryStorageTarget.o $(OUTDIR)/TransferHistory.o \
	$(OUTDIR)/Transformation.o $(OUTDIR)/XmlDataStructure.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArchiveOperation.o $(OUTDIR)/DatabaseLocation.o \
	$(OUTDIR)/DataLocation.o $(OUTDIR)/EmailMessage.o \
	$(OUTDIR)/EmailMessageSender.o $(OUTDIR)/FileShareLocation.o \
	$(OUTDIR)/FileShareSource.o $(OUTDIR)/FileShareTarget.o \
	$(OUTDIR)/FileTypeSourceLocation.o \
	$(OUTDIR)/FileTypeTargetLocation.o $(OUTDIR)/FtpLocation.o \
	$(OUTDIR)/FtpSource.o $(OUTDIR)/FtpTarget.o $(OUTDIR)/HttpLocation.o \
	$(OUTDIR)/HttpSource.o $(OUTDIR)/HttpTarget.o \
	$(OUTDIR)/JmsLocation.o $(OUTDIR)/JmsSource.o \
	$(OUTDIR)/JmsSourceCreator.o $(OUTDIR)/JmsTarget.o \
	$(OUTDIR)/LdapLocation.o $(OUTDIR)/LocationCreatorDb.o \
	$(OUTDIR)/NoSource.o $(OUTDIR)/Operation.o \
	$(OUTDIR)/OperationEngineContext.o \
	$(OUTDIR)/OperationHistoryWriter.o \
	$(OUTDIR)/OperationObjectCreatorDb.o \
	$(OUTDIR)/OperationObjectCreatorKeyValues.o \
	$(OUTDIR)/OperationSummaryWriter.o \
	$(OUTDIR)/OverrideFileTypeSourceLocation.o \
	$(OUTDIR)/PreviousTargetAsSource.o $(OUTDIR)/ProcessedFiles.o \
	$(OUTDIR)/RenameFile.o $(OUTDIR)/SalesforceBulkLoadOperation.o \
	$(OUTDIR)/SourceDataLocation.o \
	$(OUTDIR)/SourceFromHostedWebServiceCall.o \
	$(OUTDIR)/SourceTargetPipelinePluginExecution.o \
	$(OUTDIR)/SourceXmlDataStructure.o $(OUTDIR)/TargetDataLocation.o \
	$(OUTDIR)/TargetXmlDataStructure.o \
	$(OUTDIR)/TemporaryStorageLocation.o \
	$(OUTDIR)/TemporaryStorageSource.o \
	$(OUTDIR)/TemporaryStorageTarget.o $(OUTDIR)/TransferHistory.o \
	$(OUTDIR)/Transformation.o $(OUTDIR)/XmlDataStructure.o \
	-L../../../../../../lib/konga -lkonga-bulkloadenginec-d \
	-lkonga-crypto-d -lkonga-dataelement-d -lkonga-dbutils-d \
	-lkonga-filetransfer-d -lkonga-itemaccess-d -lkonga-jmsutils-d \
	-lkonga-ldap-d -lkonga-log-d -lkonga-mailclient-d \
	-lkonga-networking-d -lkonga-operationcontext-d \
	-lkonga-pipelinepluginexecutor-d -lkonga-pluginmanager-d \
	-lkonga-schemamanager-d -lkonga-server-d -lkonga-systemvariables-d \
	-lkonga-trandb-d -lkonga-utils-d -lboost_regex-$(BOOST_LIB_TAG)-d \
	-lboost_date_time-$(BOOST_LIB_TAG)-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-operationobjects-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

