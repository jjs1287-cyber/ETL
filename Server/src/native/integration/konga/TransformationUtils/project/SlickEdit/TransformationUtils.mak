# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-transformationutils-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dataelement-d -lkonga-dbrelations-d -lkonga-dbutils-d \
	-lkonga-debugger-d -lkonga-guidmappings-d -lkonga-itemaccess-d \
	-lkonga-itemproperties-d -lkonga-jdbcutils-d -lkonga-ldap-d \
	-lkonga-mailclient-d -lkonga-messaging-d -lkonga-operationcontext-d \
	-lkonga-operationdataelements-d -lkonga-operationobjects-d \
	-lkonga-trandb-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CachedDbLookup.o $(OUTDIR)/DateFormatParser.o \
	$(OUTDIR)/DateFormatUtils.o $(OUTDIR)/DbLocationConnectionInfo.o \
	$(OUTDIR)/DbLookupCache.o $(OUTDIR)/FileTypeTargetCache.o \
	$(OUTDIR)/IntegrationBreakpointLocation.o \
	$(OUTDIR)/IntegrationDebugUtils.o $(OUTDIR)/LdapExecutor.o \
	$(OUTDIR)/ReadFileImpl.o $(OUTDIR)/RunOperationImpl.o \
	$(OUTDIR)/ScriptCache.o $(OUTDIR)/SendTransformationEmail.o \
	$(OUTDIR)/TranDBUtils.o $(OUTDIR)/TransformationDataHolder.o \
	$(OUTDIR)/TransformationStatistics.o \
	$(OUTDIR)/TransformationWebServiceInfo.o \
	$(OUTDIR)/TransformFcnUtils.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CachedDbLookup.o $(OUTDIR)/DateFormatParser.o \
	$(OUTDIR)/DateFormatUtils.o $(OUTDIR)/DbLocationConnectionInfo.o \
	$(OUTDIR)/DbLookupCache.o $(OUTDIR)/FileTypeTargetCache.o \
	$(OUTDIR)/IntegrationBreakpointLocation.o \
	$(OUTDIR)/IntegrationDebugUtils.o $(OUTDIR)/LdapExecutor.o \
	$(OUTDIR)/ReadFileImpl.o $(OUTDIR)/RunOperationImpl.o \
	$(OUTDIR)/ScriptCache.o $(OUTDIR)/SendTransformationEmail.o \
	$(OUTDIR)/TranDBUtils.o $(OUTDIR)/TransformationDataHolder.o \
	$(OUTDIR)/TransformationStatistics.o \
	$(OUTDIR)/TransformationWebServiceInfo.o \
	$(OUTDIR)/TransformFcnUtils.o -L../../../../../../lib/konga \
	-lkonga-crypto-d -lkonga-dataelement-d -lkonga-dbrelations-d \
	-lkonga-dbutils-d -lkonga-debugger-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-itemproperties-d -lkonga-jdbcutils-d \
	-lkonga-ldap-d -lkonga-mailclient-d -lkonga-messaging-d \
	-lkonga-operationcontext-d -lkonga-operationdataelements-d \
	-lkonga-operationobjects-d -lkonga-trandb-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-transformationutils-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-transformationutils.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto \
	-lkonga-dataelement -lkonga-dbrelations -lkonga-dbutils \
	-lkonga-debugger -lkonga-guidmappings -lkonga-itemaccess \
	-lkonga-itemproperties -lkonga-jdbcutils -lkonga-ldap \
	-lkonga-mailclient -lkonga-messaging -lkonga-operationcontext \
	-lkonga-operationdataelements -lkonga-operationobjects \
	-lkonga-trandb -lkonga-utils 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/CachedDbLookup.o $(OUTDIR)/DateFormatParser.o \
	$(OUTDIR)/DateFormatUtils.o $(OUTDIR)/DbLocationConnectionInfo.o \
	$(OUTDIR)/DbLookupCache.o $(OUTDIR)/FileTypeTargetCache.o \
	$(OUTDIR)/IntegrationBreakpointLocation.o \
	$(OUTDIR)/IntegrationDebugUtils.o $(OUTDIR)/LdapExecutor.o \
	$(OUTDIR)/ReadFileImpl.o $(OUTDIR)/RunOperationImpl.o \
	$(OUTDIR)/ScriptCache.o $(OUTDIR)/SendTransformationEmail.o \
	$(OUTDIR)/TranDBUtils.o $(OUTDIR)/TransformationDataHolder.o \
	$(OUTDIR)/TransformationStatistics.o \
	$(OUTDIR)/TransformationWebServiceInfo.o \
	$(OUTDIR)/TransformFcnUtils.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/CachedDbLookup.o $(OUTDIR)/DateFormatParser.o \
	$(OUTDIR)/DateFormatUtils.o $(OUTDIR)/DbLocationConnectionInfo.o \
	$(OUTDIR)/DbLookupCache.o $(OUTDIR)/FileTypeTargetCache.o \
	$(OUTDIR)/IntegrationBreakpointLocation.o \
	$(OUTDIR)/IntegrationDebugUtils.o $(OUTDIR)/LdapExecutor.o \
	$(OUTDIR)/ReadFileImpl.o $(OUTDIR)/RunOperationImpl.o \
	$(OUTDIR)/ScriptCache.o $(OUTDIR)/SendTransformationEmail.o \
	$(OUTDIR)/TranDBUtils.o $(OUTDIR)/TransformationDataHolder.o \
	$(OUTDIR)/TransformationStatistics.o \
	$(OUTDIR)/TransformationWebServiceInfo.o \
	$(OUTDIR)/TransformFcnUtils.o -L../../../../../../lib/konga \
	-lkonga-crypto -lkonga-dataelement -lkonga-dbrelations \
	-lkonga-dbutils -lkonga-debugger -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-itemproperties -lkonga-jdbcutils \
	-lkonga-ldap -lkonga-mailclient -lkonga-messaging \
	-lkonga-operationcontext -lkonga-operationdataelements \
	-lkonga-operationobjects -lkonga-trandb -lkonga-utils 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-transformationutils.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
