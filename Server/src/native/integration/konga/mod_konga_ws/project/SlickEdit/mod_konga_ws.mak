# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/mod_konga_ws-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-crypto-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-httpendpoint-d -lkonga-itemaccess-d \
	-lkonga-operationcontext-d -lkonga-operationengine-d \
	-lkonga-trandb-d -lkonga-utils-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ApacheUtils.o $(OUTDIR)/HandleHostedWebService.o \
	$(OUTDIR)/HandleHttpEndpoint.o $(OUTDIR)/HandleHttpTrigger.o \
	$(OUTDIR)/HandleRequest.o $(OUTDIR)/mod_konga_ws.o \
	$(OUTDIR)/WsdlUtils.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ApacheUtils.o $(OUTDIR)/HandleHostedWebService.o \
	$(OUTDIR)/HandleHttpEndpoint.o $(OUTDIR)/HandleHttpTrigger.o \
	$(OUTDIR)/HandleRequest.o $(OUTDIR)/mod_konga_ws.o \
	$(OUTDIR)/WsdlUtils.o -L../../../../../../lib/konga/ \
	-lkonga-authentication-d -lkonga-crypto-d -lkonga-dbutils-d \
	-lkonga-guidmappings-d -lkonga-httpendpoint-d -lkonga-itemaccess-d \
	-lkonga-operationcontext-d -lkonga-operationengine-d \
	-lkonga-trandb-d -lkonga-utils-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/mod_konga_ws-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

