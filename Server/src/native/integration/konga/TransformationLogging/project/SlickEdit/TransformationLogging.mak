# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-transformationlogging-d.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dbutils-d -lkonga-server-d -lkonga-sysinfo-d \
	-lkonga-trandb-d -lkonga-utils-d -lboost_thread-$(BOOST_LIB_TAG)-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ErrorConfiguration.o $(OUTDIR)/ErrorLog.o \
	$(OUTDIR)/ViewLog.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ErrorConfiguration.o $(OUTDIR)/ErrorLog.o \
	$(OUTDIR)/ViewLog.o -L../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dbutils-d -lkonga-server-d -lkonga-sysinfo-d \
	-lkonga-trandb-d -lkonga-utils-d -lboost_thread-$(BOOST_LIB_TAG)-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-transformationlogging-d.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-transformationlogging.so
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-crypto -lkonga-dbutils \
	-lkonga-server -lkonga-sysinfo -lkonga-trandb -lkonga-utils \
	-lboost_thread-$(BOOST_LIB_TAG) 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ErrorConfiguration.o $(OUTDIR)/ErrorLog.o \
	$(OUTDIR)/ViewLog.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ErrorConfiguration.o $(OUTDIR)/ErrorLog.o \
	$(OUTDIR)/ViewLog.o -L../../../../../../lib/konga -lkonga-crypto \
	-lkonga-dbutils -lkonga-server -lkonga-sysinfo -lkonga-trandb \
	-lkonga-utils -lboost_thread-$(BOOST_LIB_TAG) 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-transformationlogging.so ../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
