	$(OUTDIR)/adb_dbLookupResponse.o $(OUTDIR)/adb_readSource.o \
	$(OUTDIR)/adb_readSourceResponse.o \
	$(OUTDIR)/adb_rollbackTransactions.o \
	$(OUTDIR)/adb_rollbackTransactionsResponse.o \
	$(OUTDIR)/adb_startNewSession.o \
	$(OUTDIR)/adb_startNewSessionResponse.o $(OUTDIR)/adb_writeTarget.o \
	$(OUTDIR)/adb_writeTargetResponse.o \
	$(OUTDIR)/adb_WsConnectionParams.o $(OUTDIR)/adb_WsDbExecuteResult.o \
	$(OUTDIR)/adb_WsDbLookupParams.o $(OUTDIR)/adb_WsDbLookupResult.o \
	$(OUTDIR)/adb_WsJdbcError.o $(OUTDIR)/adb_WsJdbcSessionId.o \
	$(OUTDIR)/adb_WsJdbcStartNewSessionResult.o \
	$(OUTDIR)/adb_WsKeyValue.o $(OUTDIR)/adb_WsReadSourceParams.o \
	$(OUTDIR)/adb_WsResultSet.o $(OUTDIR)/adb_WsResultSetRow.o \
	$(OUTDIR)/adb_WsWriteTargetParams.o \
	$(OUTDIR)/axis2_stub_JdbcEngineService.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/adb_ArrayOf_xsd_string.o \
	$(OUTDIR)/adb_ArrayOfWsKeyValue.o \
	$(OUTDIR)/adb_ArrayOfWsResultSetRow.o $(OUTDIR)/adb_cachedDbLookup.o \
	$(OUTDIR)/adb_cachedDbLookupResponse.o $(OUTDIR)/adb_closeSession.o \
	$(OUTDIR)/adb_closeSessionResponse.o \
	$(OUTDIR)/adb_commitTransactions.o \
	$(OUTDIR)/adb_commitTransactionsResponse.o $(OUTDIR)/adb_dbExecute.o \
	$(OUTDIR)/adb_dbExecuteResponse.o $(OUTDIR)/adb_dbLookup.o \
	$(OUTDIR)/adb_dbLookupResponse.o $(OUTDIR)/adb_readSource.o \
	$(OUTDIR)/adb_readSourceResponse.o \
	$(OUTDIR)/adb_rollbackTransactions.o \
	$(OUTDIR)/adb_rollbackTransactionsResponse.o \
	$(OUTDIR)/adb_startNewSession.o \
	$(OUTDIR)/adb_startNewSessionResponse.o $(OUTDIR)/adb_writeTarget.o \
	$(OUTDIR)/adb_writeTargetResponse.o \
	$(OUTDIR)/adb_WsConnectionParams.o $(OUTDIR)/adb_WsDbExecuteResult.o \
	$(OUTDIR)/adb_WsDbLookupParams.o $(OUTDIR)/adb_WsDbLookupResult.o \
	$(OUTDIR)/adb_WsJdbcError.o $(OUTDIR)/adb_WsJdbcSessionId.o \
	$(OUTDIR)/adb_WsJdbcStartNewSessionResult.o \
	$(OUTDIR)/adb_WsKeyValue.o $(OUTDIR)/adb_WsReadSourceParams.o \
	$(OUTDIR)/adb_WsResultSet.o $(OUTDIR)/adb_WsResultSetRow.o \
	$(OUTDIR)/adb_WsWriteTargetParams.o \
	$(OUTDIR)/axis2_stub_JdbcEngineService.o -laxis2_axiom \
	-laxis2_engine -laxis2_parser -laxutil -lguththila -lneethi 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.c
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-jdbcenginec-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

