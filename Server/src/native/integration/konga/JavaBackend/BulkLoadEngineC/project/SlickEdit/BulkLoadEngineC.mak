# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-bulkloadenginec-d.so
CFG_INC=
CFG_LIB=-laxis2_axiom -laxis2_engine -laxis2_parser -laxutil \
	-lguththila -lneethi 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/adb_closeBulkLoadSession.o \
	$(OUTDIR)/adb_closeBulkLoadSessionResponse.o \
	$(OUTDIR)/adb_runBulkLoad.o $(OUTDIR)/adb_runBulkLoadResponse.o \
	$(OUTDIR)/adb_startNewBulkLoadSession.o \
	$(OUTDIR)/adb_startNewBulkLoadSessionResponse.o \
	$(OUTDIR)/adb_WsBulkLoadError.o $(OUTDIR)/adb_WsBulkLoadParams.o \
	$(OUTDIR)/adb_WsBulkLoadResult.o $(OUTDIR)/adb_WsBulkLoadSessionId.o \
	$(OUTDIR)/adb_WsKeyValue.o $(OUTDIR)/adb_WsSalesforceEndpoint.o \
	$(OUTDIR)/adb_WsStartNewBulkLoadSessionResult.o \
	$(OUTDIR)/axis2_stub_BulkLoadEngineService.o \
	$(OUTDIR)/BulkLoadEngineWrapperC.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/adb_closeBulkLoadSession.o \
	$(OUTDIR)/adb_closeBulkLoadSessionResponse.o \
	$(OUTDIR)/adb_runBulkLoad.o $(OUTDIR)/adb_runBulkLoadResponse.o \
	$(OUTDIR)/adb_startNewBulkLoadSession.o \
	$(OUTDIR)/adb_startNewBulkLoadSessionResponse.o \
	$(OUTDIR)/adb_WsBulkLoadError.o $(OUTDIR)/adb_WsBulkLoadParams.o \
	$(OUTDIR)/adb_WsBulkLoadResult.o $(OUTDIR)/adb_WsBulkLoadSessionId.o \
	$(OUTDIR)/adb_WsKeyValue.o $(OUTDIR)/adb_WsSalesforceEndpoint.o \
	$(OUTDIR)/adb_WsStartNewBulkLoadSessionResult.o \
	$(OUTDIR)/axis2_stub_BulkLoadEngineService.o \
	$(OUTDIR)/BulkLoadEngineWrapperC.o -laxis2_axiom -laxis2_engine \
	-laxis2_parser -laxutil -lguththila -lneethi 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../%.c
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-bulkloadenginec-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

