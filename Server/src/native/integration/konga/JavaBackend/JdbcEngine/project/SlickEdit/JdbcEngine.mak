# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-jdbcengine-d.so
CFG_INC=
CFG_LIB=-laxis_client 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsKeyValue.o $(OUTDIR)/ArrayOfWsResultSetRow.o \
	$(OUTDIR)/JdbcEngine.o $(OUTDIR)/WsConnectionParams.o \
	$(OUTDIR)/WsDbExecuteResult.o $(OUTDIR)/WsDbLookupParams.o \
	$(OUTDIR)/WsDbLookupResult.o $(OUTDIR)/WsJdbcError.o \
	$(OUTDIR)/WsJdbcSessionId.o $(OUTDIR)/WsJdbcStartNewSessionResult.o \
	$(OUTDIR)/WsKeyValue.o $(OUTDIR)/WsKeyValue_Array.o \
	$(OUTDIR)/WsReadSourceParams.o $(OUTDIR)/WsResultSet.o \
	$(OUTDIR)/WsResultSetRow.o $(OUTDIR)/WsResultSetRow_Array.o \
	$(OUTDIR)/WsWriteTargetParams.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfWsKeyValue.o \
	$(OUTDIR)/ArrayOfWsResultSetRow.o $(OUTDIR)/JdbcEngine.o \
	$(OUTDIR)/WsConnectionParams.o $(OUTDIR)/WsDbExecuteResult.o \
	$(OUTDIR)/WsDbLookupParams.o $(OUTDIR)/WsDbLookupResult.o \
	$(OUTDIR)/WsJdbcError.o $(OUTDIR)/WsJdbcSessionId.o \
	$(OUTDIR)/WsJdbcStartNewSessionResult.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsReadSourceParams.o \
	$(OUTDIR)/WsResultSet.o $(OUTDIR)/WsResultSetRow.o \
	$(OUTDIR)/WsResultSetRow_Array.o $(OUTDIR)/WsWriteTargetParams.o \
	-laxis_client 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-jdbcengine-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-jdbcengine.so
CFG_INC=
CFG_LIB=-laxis_client 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsKeyValue.o $(OUTDIR)/ArrayOfWsResultSetRow.o \
	$(OUTDIR)/JdbcEngine.o $(OUTDIR)/WsConnectionParams.o \
	$(OUTDIR)/WsDbExecuteResult.o $(OUTDIR)/WsDbLookupParams.o \
	$(OUTDIR)/WsDbLookupResult.o $(OUTDIR)/WsJdbcError.o \
	$(OUTDIR)/WsJdbcSessionId.o $(OUTDIR)/WsJdbcStartNewSessionResult.o \
	$(OUTDIR)/WsKeyValue.o $(OUTDIR)/WsKeyValue_Array.o \
	$(OUTDIR)/WsReadSourceParams.o $(OUTDIR)/WsResultSet.o \
	$(OUTDIR)/WsResultSetRow.o $(OUTDIR)/WsResultSetRow_Array.o \
	$(OUTDIR)/WsWriteTargetParams.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfWsKeyValue.o \
	$(OUTDIR)/ArrayOfWsResultSetRow.o $(OUTDIR)/JdbcEngine.o \
	$(OUTDIR)/WsConnectionParams.o $(OUTDIR)/WsDbExecuteResult.o \
	$(OUTDIR)/WsDbLookupParams.o $(OUTDIR)/WsDbLookupResult.o \
	$(OUTDIR)/WsJdbcError.o $(OUTDIR)/WsJdbcSessionId.o \
	$(OUTDIR)/WsJdbcStartNewSessionResult.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsReadSourceParams.o \
	$(OUTDIR)/WsResultSet.o $(OUTDIR)/WsResultSetRow.o \
	$(OUTDIR)/WsResultSetRow_Array.o $(OUTDIR)/WsWriteTargetParams.o \
	-laxis_client 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-jdbcengine.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
