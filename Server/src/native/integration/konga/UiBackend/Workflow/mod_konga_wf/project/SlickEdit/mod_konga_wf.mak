# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/mod_konga_wf-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-utils-d -lkonga-wfdbwriter-d -lkonga-wfxmlreader-d \
	-lkonga-workflow-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/mod_konga_wf.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/mod_konga_wf.o -L../../../../../../../../lib/konga/ \
	-lkonga-authentication-d -lkonga-utils-d -lkonga-wfdbwriter-d \
	-lkonga-wfxmlreader-d -lkonga-workflow-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/mod_konga_wf-d.so ../../../../../../../../lib/konga

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/mod_konga_wf.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication \
	-lkonga-utils -lkonga-wfdbwriter -lkonga-wfxmlreader \
	-lkonga-workflow 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/mod_konga_wf.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/mod_konga_wf.o -L../../../../../../../../lib/konga/ \
	-lkonga-authentication -lkonga-utils -lkonga-wfdbwriter \
	-lkonga-wfxmlreader -lkonga-workflow 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/mod_konga_wf.so ../../../../../../../../lib/konga

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
