# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-uploadedfilesmanager-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dbrelations-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-sysinfo-d -lkonga-trandb-d \
	-lkonga-utils-d -lkonga-zip-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/FileUploadUtils.o $(OUTDIR)/UploadedFile.o \
	$(OUTDIR)/UploadedFilesManager.o $(OUTDIR)/WsdlCleanup.o \
	$(OUTDIR)/WsdlFilesManager.o $(OUTDIR)/XmlFilesManager.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/FileUploadUtils.o $(OUTDIR)/UploadedFile.o \
	$(OUTDIR)/UploadedFilesManager.o $(OUTDIR)/WsdlCleanup.o \
	$(OUTDIR)/WsdlFilesManager.o $(OUTDIR)/XmlFilesManager.o \
	-L../../../../../../../lib/konga -lkonga-crypto-d \
	-lkonga-dbrelations-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-sysinfo-d -lkonga-trandb-d \
	-lkonga-utils-d -lkonga-zip-d 

COMPILE=g++ -c  -ansi "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-uploadedfilesmanager-d.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-uploadedfilesmanager.so
CFG_INC=
CFG_LIB=-L../../../../../../../lib/konga -lkonga-crypto \
	-lkonga-dbrelations -lkonga-dbutils -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-sysinfo -lkonga-trandb -lkonga-utils \
	-lkonga-zip 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/FileUploadUtils.o $(OUTDIR)/UploadedFile.o \
	$(OUTDIR)/UploadedFilesManager.o $(OUTDIR)/WsdlCleanup.o \
	$(OUTDIR)/WsdlFilesManager.o $(OUTDIR)/XmlFilesManager.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/FileUploadUtils.o $(OUTDIR)/UploadedFile.o \
	$(OUTDIR)/UploadedFilesManager.o $(OUTDIR)/WsdlCleanup.o \
	$(OUTDIR)/WsdlFilesManager.o $(OUTDIR)/XmlFilesManager.o \
	-L../../../../../../../lib/konga -lkonga-crypto -lkonga-dbrelations \
	-lkonga-dbutils -lkonga-guidmappings -lkonga-itemaccess \
	-lkonga-sysinfo -lkonga-trandb -lkonga-utils -lkonga-zip 

COMPILE=g++ -c  -ansi  -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-uploadedfilesmanager.so ../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
