	-lkonga-characterencodingconversion-d -lkonga-crypto-d \
	-lkonga-dbutils-d -lkonga-debugger-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-operationcontext-d \
	-lkonga-operationengine-d -lkonga-pipelinepluginentitymanager-d \
	-lkonga-pipelinepluginexecutor-d -lkonga-pluginmanager-d \
	-lkonga-schemamanager-d -lkonga-server-d -lkonga-trandb-d \
	-lkonga-transformationdatastore-d -lkonga-transformationengine-d \
	-lkonga-uploadedfilesmanager-d -lkonga-utils-d -lkonga-wsutils-d \
	-lkonga-zip-d -laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-treemapperinfo-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
