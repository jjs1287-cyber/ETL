			<Lib File="-lkonga-zip-d"/>
			<Lib File="-laxis_server"/>
		</Libs>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bdlibkonga-ws-checkout-d.so ../../../../../../../../lib/konga/"/>
		</PostBuildCommands>
	</Config>
