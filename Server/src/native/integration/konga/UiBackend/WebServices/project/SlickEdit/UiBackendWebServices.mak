# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----

# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/UiBackendWebServices
CFG_INC=
CFG_LIB=
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/UiBackendWebServices.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/UiBackendWebServices.o 

COMPILE=g++ -c    -g -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -g -o "$(OUTFILE)" $(OBJ) $(CFG_LIB)

# Pattern rules
$(OUTDIR)/%.o : %.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR) deps $(OBJ)
	$(LINK)

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Build dependencies
deps:
	@(cd ../../Activity/project/SlickEdit/;$(MAKE) -f ActivityWs.mak CFG=$(CFG))
	@(cd ../../Admin/project/SlickEdit/;$(MAKE) -f AdminWs.mak CFG=$(CFG))
	@(cd ../../FileManagement/project/SlickEdit/;$(MAKE) -f FileManagementWs.mak CFG=$(CFG))
	@(cd ../../JobControl/project/SlickEdit/;$(MAKE) -f JobControlWs.mak CFG=$(CFG))
	@(cd ../../PluginManagement/project/SlickEdit/;$(MAKE) -f PluginManagementWs.mak CFG=$(CFG))
	@(cd ../../TestConnection/project/SlickEdit/;$(MAKE) -f TestConnectionWs.mak CFG=$(CFG))
	@(cd ../../UserAdmin/project/SlickEdit/;$(MAKE) -f UserAdminWs.mak CFG=$(CFG))
	@(cd ../../WebServiceInfoProvider/project/SlickEdit/;$(MAKE) -f WebServiceInfoProviderWs.mak CFG=$(CFG))
	@(cd ../../XmlInfoProvider/project/SlickEdit/;$(MAKE) -f XmlInfoProviderWs.mak CFG=$(CFG))
	@(cd ../../OdbcInfoProvider/project/SlickEdit/;$(MAKE) -f OdbcInfoProviderWs.mak CFG=$(CFG))

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
	@(cd ../../Activity/project/SlickEdit/;$(MAKE) -f ActivityWs.mak cleanall CFG=$(CFG))
	@(cd ../../Admin/project/SlickEdit/;$(MAKE) -f AdminWs.mak cleanall CFG=$(CFG))
	@(cd ../../FileManagement/project/SlickEdit/;$(MAKE) -f FileManagementWs.mak cleanall CFG=$(CFG))
	@(cd ../../JobControl/project/SlickEdit/;$(MAKE) -f JobControlWs.mak cleanall CFG=$(CFG))
	@(cd ../../PluginManagement/project/SlickEdit/;$(MAKE) -f PluginManagementWs.mak cleanall CFG=$(CFG))
	@(cd ../../TestConnection/project/SlickEdit/;$(MAKE) -f TestConnectionWs.mak cleanall CFG=$(CFG))
	@(cd ../../UserAdmin/project/SlickEdit/;$(MAKE) -f UserAdminWs.mak cleanall CFG=$(CFG))
	@(cd ../../WebServiceInfoProvider/project/SlickEdit/;$(MAKE) -f WebServiceInfoProviderWs.mak cleanall CFG=$(CFG))
	@(cd ../../XmlInfoProvider/project/SlickEdit/;$(MAKE) -f XmlInfoProviderWs.mak cleanall CFG=$(CFG))
	@(cd ../../OdbcInfoProvider/project/SlickEdit/;$(MAKE) -f OdbcInfoProviderWs.mak cleanall CFG=$(CFG))
endif

