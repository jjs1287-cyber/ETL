<!DOCTYPE Project SYSTEM "http://www.slickedit.com/dtd/vse/10.0/vpj.dtd">
<Project
	Version="10.0"
	VendorName="SlickEdit"
	WorkingDir="."
	BuildSystem="automakefile"
	BuildMakeFile="%rp%rn.mak">
	<Config
		Name="Debug"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-ws-testconnection-d.so"
		CompilerConfigName="Default Compiler"
		Defines='"/D_DEBUG"'>
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O0 -g -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-unused-variable -Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O0 -g -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
		</Includes>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bd/libkonga-ws-testconnection-d.so ../../../../../../../../lib/konga/"/>
		</PostBuildCommands>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../../../lib/konga/"/>
			<Lib File="-lkonga-crypto-d"/>
			<Lib File="-lkonga-dbrelations-d"/>
			<Lib File="-lkonga-dbutils-d"/>
			<Lib File="-lkonga-guidmappings-d"/>
			<Lib File="-lkonga-operationcontext-d"/>
			<Lib File="-lkonga-operationobjects-d"/>
			<Lib File="-lkonga-trandb-d"/>
			<Lib File="-lkonga-utils-d"/>
			<Lib File="-lkonga-wsutils-d"/>
			<Lib File="-laxis_server"/>
		</Libs>
	</Config>
	<Config
		Name="Release"
		Type="gnuc"
		DebugCallbackName="gdb"
		Version="1"
		OutputFile="%bdlibkonga-ws-testconnection.so"
		CompilerConfigName="Default Compiler"
		Defines="">
		<Menu>
			<Target
				Name="Compile"
				MenuCaption="&amp;Compile"
				Dialog="_gnuc_options_form Compile"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				OutputExts="*.o"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec
					CmdLine='g++ -c %xup %defd -O2 -Wall -fPIC -o "%bd%n%oe" %i "%f" %~other'
					OtherOptions="-Wno-unused-variable -Wno-reorder"/>
			</Target>
			<Target
				Name="Link"
				MenuCaption="&amp;Link"
				Dialog="_gnuc_options_form Link"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='g++ %xup -O2 -shared -fPIC -Wall -o "%o" %objs'/>
			</Target>
			<Target
				Name="Build"
				MenuCaption="&amp;Build"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" CFG=%b'/>
			</Target>
			<Target
				Name="Rebuild"
				MenuCaption="&amp;Rebuild"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveAll"
				RunFromDir="%rw"
				ClearProcessBuffer="1">
				<Exec CmdLine='gmake -f "%rp%rn.mak" rebuild CFG=%b'/>
			</Target>
			<Target
				Name="Debug"
				MenuCaption="&amp;Debug"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveNone"
				RunFromDir="%rw">
				<Exec CmdLine='"%o" "%o"'/>
			</Target>
			<Target
				Name="Execute"
				MenuCaption="E&amp;xecute"
				Dialog="_gnuc_options_form Run/Debug"
				BuildFirst="1"
				CaptureOutputWith="ProcessBuffer"
				Deletable="0"
				SaveOption="SaveWorkspaceFiles"
				RunFromDir="%rw">
				<Exec CmdLine='"%o"'/>
			</Target>
			<Target
				Name="dash"
				MenuCaption="-"
				Deletable="0">
				<Exec/>
			</Target>
			<Target
				Name="GNU C Options"
				MenuCaption="GNU C &amp;Options..."
				ShowOnMenu="HideIfNoCmdLine"
				Deletable="0"
				SaveOption="SaveNone">
				<Exec
					CmdLine="gnucoptions"
					Type="Slick-C"/>
			</Target>
		</Menu>
		<Includes>
		</Includes>
		<PostBuildCommands StopOnError="1">
			<Exec CmdLine="cp %bd/libkonga-ws-testconnection.so ../../../../../../../../lib/konga/"/>
		</PostBuildCommands>
		<Libs PreObjects="0">
			<Lib File="-L../../../../../../../../lib/konga/"/>
			<Lib File="-lkonga-crypto"/>
			<Lib File="-lkonga-dbrelations"/>
			<Lib File="-lkonga-dbutils"/>
			<Lib File="-lkonga-guidmappings"/>
			<Lib File="-lkonga-operationcontext"/>
			<Lib File="-lkonga-operationobjects"/>
			<Lib File="-lkonga-trandb"/>
			<Lib File="-lkonga-utils"/>
			<Lib File="-lkonga-wsutils"/>
			<Lib File="-laxis_server"/>
		</Libs>
	</Config>
	<Files>
		<Folder
			Name="Source Files"
			Filters="*.c;*.C;*.cc;*.cpp;*.cp;*.cxx;*.prg;*.pas;*.dpr;*.asm;*.s;*.bas;*.java;*.cs;*.sc;*.e;*.cob;*.html;*.rc;*.tcl;*.py;*.pl">
			<F N="../../ArrayOf_xsd_string.cpp"/>
			<F N="../../AxisServiceException.cpp"/>
			<F N="../../ConnectionInfo.cpp"/>
			<F N="../../FileList.cpp"/>
			<F N="../../TestConnection.cpp"/>
			<F N="../../TestConnectionService.cpp"/>
			<F N="../../TestConnectionWrapper.cpp"/>
		</Folder>
		<Folder
			Name="Header Files"
			Filters="*.h;*.H;*.hh;*.hpp;*.hxx;*.inc;*.sh;*.cpy;*.if">
			<F N="../../ArrayOf_xsd_string.hpp"/>
			<F N="../../AxisServiceException.hpp"/>
			<F N="../../ConnectionInfo.hpp"/>
			<F N="../../FileList.hpp"/>
			<F N="../../TestConnection.hpp"/>
			<F N="../../TestConnectionWrapper.hpp"/>
		</Folder>
		<Folder
			Name="Other Files"
			Filters="*.wsdd,*.bat,*.wsdl">
			<F N="../../deploy.wsdd"/>
			<F N="../../generate_stubs.bat"/>
			<F N="../../generate_wsdl.bat"/>
			<F N="../../konga_test_connection.wsdl"/>
			<F N="../../undeploy.wsdd"/>
			<F N="../../wsdl_generation_settings.bat"/>
		</Folder>
		<Folder
			Name="Impl"
			Filters="">
			<F N="../../Impl/TestConnectionImpl.cpp"/>
			<F N="../../Impl/TestConnectionImpl.h"/>
			<F
				N="TestConnectionWs.mak"
				Type="Makefile"/>
		</Folder>
	</Files>
</Project>
