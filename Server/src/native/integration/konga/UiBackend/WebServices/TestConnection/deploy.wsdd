<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="TestConnectionService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/TestConnectionService.dll"/>
		<parameter name="allowedMethods" value="testFileTypeConnection testFileTypeConnection testDatabaseConnection testDatabaseConnection testLdapConnection testLdapConnection "/>
	</service>
</deployment>
