<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="JobControlService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/JobControlService.dll"/>
		<parameter name="allowedMethods" value="RunOperation RunOperation RunOperationMD5Password RunOperationMD5Password RunOperationWithSourceData RunOperationWithSourceData RunOperationInstanceMD5Password RunOperationInstanceMD5Password "/>
	</service>
</deployment>
