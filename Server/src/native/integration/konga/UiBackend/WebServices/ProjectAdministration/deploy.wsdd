<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="ProjectAdministrationService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/ProjectAdministrationService.dll"/>
		<parameter name="allowedMethods" value="DisableSchedules DisableSchedules EnableSchedules EnableSchedules DisableScheduleForOperation DisableScheduleForOperation EnableScheduleForOperation EnableScheduleForOperation FindScheduledOperations FindScheduledOperations TestScheduleWithKeyValues TestScheduleWithKeyValues TestScheduleWithGuid TestScheduleWithGuid "/>
	</service>
</deployment>
