# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-ws-odbc_infoprovider-d.so
CFG_INC=-I../../../../../.. 
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-dbutils-d -lkonga-guidmappings-d -lkonga-itemaccess-d \
	-lkonga-operationcontext-d -lkonga-schemainfo-d \
	-lkonga-trandbutils-d -lkonga-utils-d -lkonga-wsutils-d \
	-laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsDatabaseColumn.o \
	$(OUTDIR)/ArrayOfWsDatabaseObject.o \
	$(OUTDIR)/ArrayOfWsOdbcDriverDescriptor.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/OdbcInfoProvider.o \
	$(OUTDIR)/OdbcInfoProviderService.o \
	$(OUTDIR)/OdbcInfoProviderWrapper.o $(OUTDIR)/WsDatabaseColumn.o \
	$(OUTDIR)/WsDatabaseColumn_Array.o $(OUTDIR)/WsDatabaseDriverInfo.o \
	$(OUTDIR)/WsDatabaseInfo.o $(OUTDIR)/WsDatabaseObject.o \
	$(OUTDIR)/WsDatabaseObject_Array.o \
	$(OUTDIR)/WsOdbcDriverDescriptor.o \
	$(OUTDIR)/WsOdbcDriverDescriptor_Array.o \
	$(OUTDIR)/OdbcInfoProviderImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsDatabaseColumn.o \
	$(OUTDIR)/ArrayOfWsDatabaseObject.o \
	$(OUTDIR)/ArrayOfWsOdbcDriverDescriptor.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/OdbcInfoProvider.o \
	$(OUTDIR)/OdbcInfoProviderService.o \
	$(OUTDIR)/OdbcInfoProviderWrapper.o $(OUTDIR)/WsDatabaseColumn.o \
	$(OUTDIR)/WsDatabaseColumn_Array.o $(OUTDIR)/WsDatabaseDriverInfo.o \
	$(OUTDIR)/WsDatabaseInfo.o $(OUTDIR)/WsDatabaseObject.o \
	$(OUTDIR)/WsDatabaseObject_Array.o \
	$(OUTDIR)/WsOdbcDriverDescriptor.o \
	$(OUTDIR)/WsOdbcDriverDescriptor_Array.o \
	$(OUTDIR)/OdbcInfoProviderImpl.o \
	-L../../../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-dbutils-d -lkonga-guidmappings-d -lkonga-itemaccess-d \
	-lkonga-operationcontext-d -lkonga-schemainfo-d \
	-lkonga-trandbutils-d -lkonga-utils-d -lkonga-wsutils-d \
	-laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-odbc_infoprovider-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-ws-odbc_infoprovider.so
CFG_INC=-I../../../../../.. 
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication \
	-lkonga-dbutils -lkonga-guidmappings -lkonga-itemaccess \
	-lkonga-operationcontext -lkonga-schemainfo -lkonga-trandbutils \
	-lkonga-utils -lkonga-wsutils -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsDatabaseColumn.o \
	$(OUTDIR)/ArrayOfWsDatabaseObject.o \
	$(OUTDIR)/ArrayOfWsOdbcDriverDescriptor.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/OdbcInfoProvider.o \
	$(OUTDIR)/OdbcInfoProviderService.o \
	$(OUTDIR)/OdbcInfoProviderWrapper.o $(OUTDIR)/WsDatabaseColumn.o \
	$(OUTDIR)/WsDatabaseColumn_Array.o $(OUTDIR)/WsDatabaseDriverInfo.o \
	$(OUTDIR)/WsDatabaseInfo.o $(OUTDIR)/WsDatabaseObject.o \
	$(OUTDIR)/WsDatabaseObject_Array.o \
	$(OUTDIR)/WsOdbcDriverDescriptor.o \
	$(OUTDIR)/WsOdbcDriverDescriptor_Array.o \
	$(OUTDIR)/OdbcInfoProviderImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfWsDatabaseColumn.o \
	$(OUTDIR)/ArrayOfWsDatabaseObject.o \
	$(OUTDIR)/ArrayOfWsOdbcDriverDescriptor.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/OdbcInfoProvider.o \
	$(OUTDIR)/OdbcInfoProviderService.o \
	$(OUTDIR)/OdbcInfoProviderWrapper.o $(OUTDIR)/WsDatabaseColumn.o \
	$(OUTDIR)/WsDatabaseColumn_Array.o $(OUTDIR)/WsDatabaseDriverInfo.o \
	$(OUTDIR)/WsDatabaseInfo.o $(OUTDIR)/WsDatabaseObject.o \
	$(OUTDIR)/WsDatabaseObject_Array.o \
	$(OUTDIR)/WsOdbcDriverDescriptor.o \
	$(OUTDIR)/WsOdbcDriverDescriptor_Array.o \
	$(OUTDIR)/OdbcInfoProviderImpl.o \
	-L../../../../../../../../lib/konga/ -lkonga-authentication \
	-lkonga-dbutils -lkonga-guidmappings -lkonga-itemaccess \
	-lkonga-operationcontext -lkonga-schemainfo -lkonga-trandbutils \
	-lkonga-utils -lkonga-wsutils -laxis_server 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-odbc_infoprovider.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
