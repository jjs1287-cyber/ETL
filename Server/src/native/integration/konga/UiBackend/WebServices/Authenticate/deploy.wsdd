<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="AuthenticateService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/AuthenticateService.dll"/>
		<parameter name="allowedMethods" value="login login loginWithVersion loginWithVersion loginWithVersionAndKeyValues loginWithVersionAndKeyValues "/>
	</service>
</deployment>
