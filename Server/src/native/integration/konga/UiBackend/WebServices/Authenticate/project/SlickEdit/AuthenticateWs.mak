# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-ws-authenticate-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga -lkonga-authentication-d \
	-lkonga-guidmappings-d -lkonga-server-d -lkonga-serverversion-d \
	-lkonga-sysinfo-d -lkonga-utils-d -lkonga-wsutils-d -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o \
	$(OUTDIR)/Authenticate.o $(OUTDIR)/AuthenticateResult.o \
	$(OUTDIR)/AuthenticateService.o $(OUTDIR)/AuthenticateWrapper.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsKeyValuePairs.o \
	$(OUTDIR)/AuthenticateImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o $(OUTDIR)/Authenticate.o \
	$(OUTDIR)/AuthenticateResult.o $(OUTDIR)/AuthenticateService.o \
	$(OUTDIR)/AuthenticateWrapper.o $(OUTDIR)/AxisServiceException.o \
	$(OUTDIR)/WsKeyValue.o $(OUTDIR)/WsKeyValue_Array.o \
	$(OUTDIR)/WsKeyValuePairs.o $(OUTDIR)/AuthenticateImpl.o \
	-L../../../../../../../../lib/konga -lkonga-authentication-d \
	-lkonga-guidmappings-d -lkonga-server-d -lkonga-serverversion-d \
	-lkonga-sysinfo-d -lkonga-utils-d -lkonga-wsutils-d -laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-authenticate-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

