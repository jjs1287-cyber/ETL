<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="ActivityInfoProviderService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/ActivityInfoProviderService.dll"/>
		<parameter name="allowedMethods" value="getOperationLog getOperationLog getOperationProgress getOperationProgress getSourceFileHistoryLog getSourceFileHistoryLog deleteSourceFileHistory deleteSourceFileHistory deleteOperationLogEntry deleteOperationLogEntry cancelOperations cancelOperations "/>
	</service>
</deployment>
