<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:CPP="http://xml.apache.org/axis/wsdd/providers/CPP">
	<service name="XmlInfoProviderService" provider="CPP:DOCUMENT" description="Axis C++ web service">
		<parameter name="className" value="/user/local/apache/axis/XmlInfoProviderService.dll"/>
		<parameter name="allowedMethods" value="getXmlStructureFiles getXmlStructureFiles getXmlStructureFile getXmlStructureFile getPossibleRootNames getPossibleRootNames uploadStructureFile uploadStructureFile "/>
	</service>
</deployment>
