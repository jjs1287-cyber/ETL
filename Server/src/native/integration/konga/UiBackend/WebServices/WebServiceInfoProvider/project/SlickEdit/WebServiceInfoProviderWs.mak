# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-ws-webserviceinfo-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga -lkonga-dbrelations-d \
	-lkonga-dbutils-d -lkonga-filetransfer-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-schemamanager-d \
	-lkonga-transformationengine-d -lkonga-uploadedfilesmanager-d \
	-lkonga-utils-d -lkonga-wsutils-d -lkonga-xml-d -lkonga-zip-d \
	-laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfCWsdlFile.o $(OUTDIR)/AxisServiceException.o \
	$(OUTDIR)/CWsdlFile.o $(OUTDIR)/CWsdlFile_Array.o \
	$(OUTDIR)/CWsdlFileDownloadResult.o $(OUTDIR)/CWsdlFiles.o \
	$(OUTDIR)/CWsdlFileUploadResult.o $(OUTDIR)/WebServiceInfoProvider.o \
	$(OUTDIR)/WebServiceInfoProviderService.o \
	$(OUTDIR)/WebServiceInfoProviderWrapper.o $(OUTDIR)/WebServiceJtr.o \
	$(OUTDIR)/WebServiceOperationData.o \
	$(OUTDIR)/WebServiceInfoProviderImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfCWsdlFile.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/CWsdlFile.o \
	$(OUTDIR)/CWsdlFile_Array.o $(OUTDIR)/CWsdlFileDownloadResult.o \
	$(OUTDIR)/CWsdlFiles.o $(OUTDIR)/CWsdlFileUploadResult.o \
	$(OUTDIR)/WebServiceInfoProvider.o \
	$(OUTDIR)/WebServiceInfoProviderService.o \
	$(OUTDIR)/WebServiceInfoProviderWrapper.o $(OUTDIR)/WebServiceJtr.o \
	$(OUTDIR)/WebServiceOperationData.o \
	$(OUTDIR)/WebServiceInfoProviderImpl.o \
	-L../../../../../../../../lib/konga -lkonga-dbrelations-d \
	-lkonga-dbutils-d -lkonga-filetransfer-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-schemamanager-d \
	-lkonga-transformationengine-d -lkonga-uploadedfilesmanager-d \
	-lkonga-utils-d -lkonga-wsutils-d -lkonga-xml-d -lkonga-zip-d \
	-laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-webserviceinfo-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-ws-webserviceinfo.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga -lkonga-dbrelations \
	-lkonga-dbutils -lkonga-filetransfer -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-schemamanager \
	-lkonga-transformationengine -lkonga-uploadedfilesmanager \
	-lkonga-utils -lkonga-wsutils -lkonga-xml -lkonga-zip -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o \
	$(OUTDIR)/ArrayOfCWsdlFile.o $(OUTDIR)/AxisServiceException.o \
	$(OUTDIR)/CWsdlFile.o $(OUTDIR)/CWsdlFile_Array.o \
	$(OUTDIR)/CWsdlFileDownloadResult.o $(OUTDIR)/CWsdlFiles.o \
	$(OUTDIR)/CWsdlFileUploadResult.o $(OUTDIR)/WebServiceInfoProvider.o \
	$(OUTDIR)/WebServiceInfoProviderService.o \
	$(OUTDIR)/WebServiceInfoProviderWrapper.o $(OUTDIR)/WebServiceJtr.o \
	$(OUTDIR)/WebServiceOperationData.o \
	$(OUTDIR)/WebServiceInfoProviderImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfCWsdlFile.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/CWsdlFile.o \
	$(OUTDIR)/CWsdlFile_Array.o $(OUTDIR)/CWsdlFileDownloadResult.o \
	$(OUTDIR)/CWsdlFiles.o $(OUTDIR)/CWsdlFileUploadResult.o \
	$(OUTDIR)/WebServiceInfoProvider.o \
	$(OUTDIR)/WebServiceInfoProviderService.o \
	$(OUTDIR)/WebServiceInfoProviderWrapper.o $(OUTDIR)/WebServiceJtr.o \
	$(OUTDIR)/WebServiceOperationData.o \
	$(OUTDIR)/WebServiceInfoProviderImpl.o \
	-L../../../../../../../../lib/konga -lkonga-dbrelations \
	-lkonga-dbutils -lkonga-filetransfer -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-schemamanager \
	-lkonga-transformationengine -lkonga-uploadedfilesmanager \
	-lkonga-utils -lkonga-wsutils -lkonga-xml -lkonga-zip -laxis_server 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-webserviceinfo.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
