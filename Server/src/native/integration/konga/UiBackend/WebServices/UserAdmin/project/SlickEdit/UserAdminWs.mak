# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-ws-useradmin-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-crypto-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-trandb-d -lkonga-utils-d \
	-lkonga-wsutils-d -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfGroup.o \
	$(OUTDIR)/ArrayOfUser.o $(OUTDIR)/ArrayOfUserGroup.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/Group.o \
	$(OUTDIR)/Group_Array.o $(OUTDIR)/User.o $(OUTDIR)/User_Array.o \
	$(OUTDIR)/UserAdmin.o $(OUTDIR)/UserAdminService.o \
	$(OUTDIR)/UserAdminWrapper.o $(OUTDIR)/UserGroup.o \
	$(OUTDIR)/UserGroup_Array.o $(OUTDIR)/UsersAndGroups.o \
	$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o $(OUTDIR)/UserAdminImpl.o \
	$(OUTDIR)/UserAdminUtils.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsKeyValuePairs.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfGroup.o \
	$(OUTDIR)/ArrayOfUser.o $(OUTDIR)/ArrayOfUserGroup.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/Group.o \
	$(OUTDIR)/Group_Array.o $(OUTDIR)/User.o $(OUTDIR)/User_Array.o \
	$(OUTDIR)/UserAdmin.o $(OUTDIR)/UserAdminService.o \
	$(OUTDIR)/UserAdminWrapper.o $(OUTDIR)/UserGroup.o \
	$(OUTDIR)/UserGroup_Array.o $(OUTDIR)/UsersAndGroups.o \
	$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o $(OUTDIR)/UserAdminImpl.o \
	$(OUTDIR)/UserAdminUtils.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsKeyValuePairs.o \
	-L../../../../../../../../lib/konga/ -lkonga-authentication-d \
	-lkonga-crypto-d -lkonga-dbutils-d -lkonga-guidmappings-d \
	-lkonga-itemaccess-d -lkonga-trandb-d -lkonga-utils-d \
	-lkonga-wsutils-d -laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-useradmin-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-ws-useradmin.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga/ -lkonga-authentication \
	-lkonga-crypto -lkonga-dbutils -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-trandb -lkonga-utils -lkonga-wsutils \
	-laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfGroup.o \
	$(OUTDIR)/ArrayOfUser.o $(OUTDIR)/ArrayOfUserGroup.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/Group.o \
	$(OUTDIR)/Group_Array.o $(OUTDIR)/User.o $(OUTDIR)/User_Array.o \
	$(OUTDIR)/UserAdmin.o $(OUTDIR)/UserAdminService.o \
	$(OUTDIR)/UserAdminWrapper.o $(OUTDIR)/UserGroup.o \
	$(OUTDIR)/UserGroup_Array.o $(OUTDIR)/UsersAndGroups.o \
	$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o $(OUTDIR)/UserAdminImpl.o \
	$(OUTDIR)/UserAdminUtils.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsKeyValuePairs.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/ArrayOf_xsd_string.o $(OUTDIR)/ArrayOfGroup.o \
	$(OUTDIR)/ArrayOfUser.o $(OUTDIR)/ArrayOfUserGroup.o \
	$(OUTDIR)/AxisServiceException.o $(OUTDIR)/Group.o \
	$(OUTDIR)/Group_Array.o $(OUTDIR)/User.o $(OUTDIR)/User_Array.o \
	$(OUTDIR)/UserAdmin.o $(OUTDIR)/UserAdminService.o \
	$(OUTDIR)/UserAdminWrapper.o $(OUTDIR)/UserGroup.o \
	$(OUTDIR)/UserGroup_Array.o $(OUTDIR)/UsersAndGroups.o \
	$(OUTDIR)/ArrayOf_tns2_WsKeyValue.o $(OUTDIR)/UserAdminImpl.o \
	$(OUTDIR)/UserAdminUtils.o $(OUTDIR)/WsKeyValue.o \
	$(OUTDIR)/WsKeyValue_Array.o $(OUTDIR)/WsKeyValuePairs.o \
	-L../../../../../../../../lib/konga/ -lkonga-authentication \
	-lkonga-crypto -lkonga-dbutils -lkonga-guidmappings \
	-lkonga-itemaccess -lkonga-trandb -lkonga-utils -lkonga-wsutils \
	-laxis_server 

COMPILE=g++ -c   -O3 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O3 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-useradmin.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
