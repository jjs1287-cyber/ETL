# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/libkonga-ws-pluginmanagement-d.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga -lkonga-dbutils-d \
	-lkonga-itemaccess-d -lkonga-pluginmanager-d -lkonga-utils-d \
	-lkonga-wsutils-d -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/AxisServiceException.o $(OUTDIR)/FilterAsXml.o \
	$(OUTDIR)/FilterAsXml_Array.o $(OUTDIR)/PluginManager.o \
	$(OUTDIR)/PluginManagerService.o $(OUTDIR)/PluginManagerWrapper.o \
	$(OUTDIR)/PluginManagementImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/AxisServiceException.o $(OUTDIR)/FilterAsXml.o \
	$(OUTDIR)/FilterAsXml_Array.o $(OUTDIR)/PluginManager.o \
	$(OUTDIR)/PluginManagerService.o $(OUTDIR)/PluginManagerWrapper.o \
	$(OUTDIR)/PluginManagementImpl.o -L../../../../../../../../lib/konga \
	-lkonga-dbutils-d -lkonga-itemaccess-d -lkonga-pluginmanager-d \
	-lkonga-utils-d -lkonga-wsutils-d -laxis_server 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O0 -g -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-pluginmanagement-d.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/libkonga-ws-pluginmanagement.so
CFG_INC=
CFG_LIB=-L../../../../../../../../lib/konga -lkonga-dbutils \
	-lkonga-itemaccess -lkonga-pluginmanager -lkonga-utils \
	-lkonga-wsutils -laxis_server 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/AxisServiceException.o $(OUTDIR)/FilterAsXml.o \
	$(OUTDIR)/FilterAsXml_Array.o $(OUTDIR)/PluginManager.o \
	$(OUTDIR)/PluginManagerService.o $(OUTDIR)/PluginManagerWrapper.o \
	$(OUTDIR)/PluginManagementImpl.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/AxisServiceException.o $(OUTDIR)/FilterAsXml.o \
	$(OUTDIR)/FilterAsXml_Array.o $(OUTDIR)/PluginManager.o \
	$(OUTDIR)/PluginManagerService.o $(OUTDIR)/PluginManagerWrapper.o \
	$(OUTDIR)/PluginManagementImpl.o -L../../../../../../../../lib/konga \
	-lkonga-dbutils -lkonga-itemaccess -lkonga-pluginmanager \
	-lkonga-utils -lkonga-wsutils -laxis_server 

COMPILE=g++ -c   -O2 -Wall -fPIC -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<" -Wno-unused-variable -Wno-reorder
LINK=g++  -O2 -shared -fPIC -Wall -o "$(OUTFILE)" $(ALL_OBJ)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

$(OUTDIR)/%.o : ../../Impl/%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/libkonga-ws-pluginmanagement.so ../../../../../../../../lib/konga/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
