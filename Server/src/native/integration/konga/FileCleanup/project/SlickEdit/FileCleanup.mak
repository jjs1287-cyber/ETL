# SlickEdit generated file.  Do not edit this file except in designated areas.

# Make command to use for dependencies
MAKE=gmake
RM=rm
MKDIR=mkdir

# -----Begin user-editable area-----
include depend.inc
# -----End user-editable area-----

# If no configuration is specified, "Debug" will be used
ifndef "CFG"
CFG=Debug
endif

#
# Configuration: Debug
#
ifeq "$(CFG)" "Debug"
OUTDIR=Debug
OUTFILE=$(OUTDIR)/ETLForgeFileCleanup
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-dbmaintenance-d \
	-lkonga-dbutils-d -lkonga-log-d -lkonga-networking-d \
	-lkonga-operationlog-d -lkonga-serverversion-d \
	-lkonga-transformationdatastore-d -lkonga-utils-d -lkonga-xml-d \
	-lkonga-zip-d -lboost_filesystem-$(BOOST_LIB_TAG)-d \
	-lboost_thread-$(BOOST_LIB_TAG)-d 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/BillingTabCleanupRule.o $(OUTDIR)/CleanupUtils.o \
	$(OUTDIR)/DbMaintenanceCleanupRule.o $(OUTDIR)/FileCleanup.o \
	$(OUTDIR)/FileCleanupMain.o $(OUTDIR)/OperationLogCleanupRule.o \
	$(OUTDIR)/RuleParser.o $(OUTDIR)/TransferHistoryCleanupRule.o \
	$(OUTDIR)/TransformationDataStoreCleanupRule.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/BillingTabCleanupRule.o $(OUTDIR)/CleanupUtils.o \
	$(OUTDIR)/DbMaintenanceCleanupRule.o $(OUTDIR)/FileCleanup.o \
	$(OUTDIR)/FileCleanupMain.o $(OUTDIR)/OperationLogCleanupRule.o \
	$(OUTDIR)/RuleParser.o $(OUTDIR)/TransferHistoryCleanupRule.o \
	$(OUTDIR)/TransformationDataStoreCleanupRule.o \
	-L../../../../../../lib/konga -lkonga-dbmaintenance-d \
	-lkonga-dbutils-d -lkonga-log-d -lkonga-networking-d \
	-lkonga-operationlog-d -lkonga-serverversion-d \
	-lkonga-transformationdatastore-d -lkonga-utils-d -lkonga-xml-d \
	-lkonga-zip-d -lboost_filesystem-$(BOOST_LIB_TAG)-d \
	-lboost_thread-$(BOOST_LIB_TAG)-d 

COMPILE=g++ -c  "-D_DEBUG" -O0 -g -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O0 -g -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeFileCleanup ../../../../../../bin/konga/Debug/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif

#
# Configuration: Release
#
ifeq "$(CFG)" "Release"
OUTDIR=Release
OUTFILE=$(OUTDIR)/ETLForgeFileCleanup
CFG_INC=
CFG_LIB=-L../../../../../../lib/konga -lkonga-dbmaintenance \
	-lkonga-dbutils -lkonga-log -lkonga-networking -lkonga-operationlog \
	-lkonga-serverversion -lkonga-transformationdatastore -lkonga-utils \
	-lkonga-xml -lkonga-zip -lboost_filesystem-$(BOOST_LIB_TAG) \
	-lboost_thread-$(BOOST_LIB_TAG) 
CFG_OBJ=
COMMON_OBJ=$(OUTDIR)/BillingTabCleanupRule.o $(OUTDIR)/CleanupUtils.o \
	$(OUTDIR)/DbMaintenanceCleanupRule.o $(OUTDIR)/FileCleanup.o \
	$(OUTDIR)/FileCleanupMain.o $(OUTDIR)/OperationLogCleanupRule.o \
	$(OUTDIR)/RuleParser.o $(OUTDIR)/TransferHistoryCleanupRule.o \
	$(OUTDIR)/TransformationDataStoreCleanupRule.o 
OBJ=$(COMMON_OBJ) $(CFG_OBJ)
ALL_OBJ=$(OUTDIR)/BillingTabCleanupRule.o $(OUTDIR)/CleanupUtils.o \
	$(OUTDIR)/DbMaintenanceCleanupRule.o $(OUTDIR)/FileCleanup.o \
	$(OUTDIR)/FileCleanupMain.o $(OUTDIR)/OperationLogCleanupRule.o \
	$(OUTDIR)/RuleParser.o $(OUTDIR)/TransferHistoryCleanupRule.o \
	$(OUTDIR)/TransformationDataStoreCleanupRule.o \
	-L../../../../../../lib/konga -lkonga-dbmaintenance -lkonga-dbutils \
	-lkonga-log -lkonga-networking -lkonga-operationlog \
	-lkonga-serverversion -lkonga-transformationdatastore -lkonga-utils \
	-lkonga-xml -lkonga-zip -lboost_filesystem-$(BOOST_LIB_TAG) \
	-lboost_thread-$(BOOST_LIB_TAG) 

COMPILE=g++ -c   -O2 -Wall -o "$(OUTDIR)/$(*F).o" $(CFG_INC) "$<"
LINK=g++  -O2 -Wall -o "$(OUTFILE)" $(ALL_OBJ) $(LD_FLAGS_EXE)

# Pattern rules
$(OUTDIR)/%.o : ../../%.cpp
	$(COMPILE)

# Build rules
all: $(OUTFILE)

$(OUTFILE): $(OUTDIR)  $(OBJ)
	$(LINK)
	cp $(OUTDIR)/ETLForgeFileCleanup ../../../../../../bin/konga/Release/

$(OUTDIR):
	$(MKDIR) -p "$(OUTDIR)"

# Rebuild this project
rebuild: cleanall all

# Clean this project
clean:
	$(RM) -f $(OUTFILE)
	$(RM) -f $(OBJ)

# Clean this project and all dependencies
cleanall: clean
endif
