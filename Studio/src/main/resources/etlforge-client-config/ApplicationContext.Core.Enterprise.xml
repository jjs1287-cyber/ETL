<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
		xsi:schemaLocation="
		http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-2.0.xsd"
		default-lazy-init="true">

	<bean id="preferences.page.Deploy" class="com.etlforge.integration.client.deploy.ui.prefs.DeployPreferencesPage" />

	<bean id="core.PreDeployJobs" class="com.google.common.collect.ImmutableList" factory-method="copyOf">
		<constructor-arg>
			<list>
				<bean class="com.etlforge.integration.client.deploy.ServerDeployCheckJobFactory" />
			</list>
		</constructor-arg>
	</bean>

</beans>