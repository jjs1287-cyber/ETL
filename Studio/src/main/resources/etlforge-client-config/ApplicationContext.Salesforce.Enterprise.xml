	<bean id="Sfdc.Update.Download.Config" class="org.etlforge.integration.data.entity.sfdc.SalesforceUpdateDownloadConfig" factory-method="newConfig" /> 
	<bean id="Sfdc.Delete.Download.Config" class="com.etlforge.integration.data.entity.sfdc.SalesforceDeleteDownloadConfig" factory-method="newConfig" /> 
